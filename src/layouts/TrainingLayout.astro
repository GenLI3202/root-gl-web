---
import "@/styles/global.css";
import type { Bilingual } from "@/data/training-sessions";

/**
 * Document shell for the training room. It stands apart from the site: no nav, no footer,
 * the lime training palette in both themes, and kept out of search results.
 *
 * The room speaks Chinese or English. The language sits on <html data-train-lang>, set before the
 * first paint: the visitor's last choice, else the language of the cycling page they came from
 * (the `back` link), else Chinese. Text written with <Bi> shows only the active language. The
 * follow-along app reads the same choice and serves its voice sprites from /training/voice/.
 */
interface Props {
  title: Bilingual;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-train-lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title.zh}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Noto+Sans+SC:wght@500;700;900&display=swap"
    />
    <script is:inline define:vars={{ titles: title }}>
      (() => {
        const ok = (v) => (v === "zh" || v === "en" ? v : null);
        let lang = null;
        try {
          lang = ok(localStorage.getItem("training-lang"));
        } catch (_) {}
        if (!lang) {
          let back = new URLSearchParams(location.search).get("back") || "";
          try {
            back = back || sessionStorage.getItem("training-back") || "";
          } catch (_) {}
          lang = back && !back.startsWith("/zh/") ? "en" : "zh";
        }
        const root = document.documentElement;
        root.dataset.trainLang = lang;
        root.lang = lang === "en" ? "en" : "zh-CN";
        document.title = titles[lang];
        window.FOLLOW_VOICE = "/training/voice/";
        window.addEventListener("training-lang", (ev) => (document.title = titles[ev.detail] || document.title));
      })();
    </script>
  </head>
  <body class="training-room">
    <slot />
  </body>
</html>

<style is:global>
  body.training-room {
    margin: 0;
    min-height: 100vh;
    background: var(--train-lime);
    color: var(--train-ink);
    font-family: "Bricolage Grotesque", "Noto Sans SC", -apple-system, "PingFang SC", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  body.training-room::before {
    display: none;
  }

  /* the site's serif display face is for the site; the room keeps its own grotesque in both languages */
  body.training-room :is(h1, h2, h3) {
    font-family: inherit;
  }

  html[data-train-lang="en"] [data-l="zh"],
  html:not([data-train-lang="en"]) [data-l="en"] {
    display: none !important;
  }
</style>
