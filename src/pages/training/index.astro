---
import TrainingLayout from "@/layouts/TrainingLayout.astro";
import TrainingSessionCard from "@/components/TrainingSessionCard.astro";
import TrainingLangSwitch from "@/components/TrainingLangSwitch.astro";
import Bi from "@/components/Bi.astro";
import { FOCUS_SESSIONS, TRAINING_SESSIONS, TODAY_SESSION } from "@/data/training-sessions";

/** The training room: pick a session theme. Reached only through the dumbbell on the cycling page. */
const today = TRAINING_SESSIONS.find((s) => s.id === TODAY_SESSION);
const others = TRAINING_SESSIONS.filter((s) => s.id !== TODAY_SESSION);
---

<TrainingLayout title={{ zh: "训练室", en: "Training room" }}>
  <main class="room">
    <div class="top-row">
      <a class="back" href="/hobbies/cycling/" data-back>
        ← <Bi text={{ zh: "回到骑行", en: "Back to cycling" }} />
      </a>
      <TrainingLangSwitch />
    </div>
    <header class="room-head">
      <h1><Bi text={{ zh: "训练室", en: "Training room" }} /></h1>
      <p>
        <Bi
          text={{
            zh: "选一个主题：九节周期课，外加四节专项课，都能跟练。",
            en: "Pick a theme: nine plan sessions and four focused ones, all ready to follow along.",
          }}
        />
      </p>
    </header>

    {today && (
      <section class="today-slot" aria-labelledby="today-h">
        <h2 id="today-h" class="sr-only"><Bi text={{ zh: "今天的训练", en: "Today's session" }} /></h2>
        <TrainingSessionCard session={today} today />
      </section>
    )}

    <section aria-labelledby="all-h">
      <h2 id="all-h" class="all-title">
        <Bi
          text={{
            zh: `全部主题 · ${TRAINING_SESSIONS.length} 种`,
            en: `All themes · ${TRAINING_SESSIONS.length}`,
          }}
        />
      </h2>
      <div class="grid">
        {others.map((s) => <TrainingSessionCard session={s} />)}
      </div>
    </section>

    <section aria-labelledby="focus-h">
      <h2 id="focus-h" class="all-title">
        <Bi text={{ zh: `专项 · ${FOCUS_SESSIONS.length} 种`, en: `Focused · ${FOCUS_SESSIONS.length}` }} />
      </h2>
      <p class="section-note">
        <Bi
          text={{
            zh: "不在每周计划里：哪里想补练哪里，轻松骑完或单独做都行，一周 2–3 次就够。",
            en: "Not part of the weekly plan: train the area you want, after an easy ride or on its own, 2–3 times a week.",
          }}
        />
      </p>
      <div class="grid">
        {FOCUS_SESSIONS.map((s) => <TrainingSessionCard session={s} moves />)}
      </div>
    </section>

    <p class="foot">
      <Bi
        text={{
          zh: "周期课来自每周训练规划里的 9 种力量课模板，按 Friel 与 Doyle 的周期安排；专项课的动作按 Doyle 第 7–11 章和肌电研究挑选。",
          en: "The plan sessions are the nine strength templates of my weekly training plan, periodized after Friel and Doyle; the focused ones pick their moves from Doyle ch. 7–11 and EMG studies.",
        }}
      />
    </p>
  </main>
</TrainingLayout>

<script>
  /* return to the cycling page in the language the visitor came from */
  const back = new URLSearchParams(window.location.search).get("back");
  const link = document.querySelector<HTMLAnchorElement>("[data-back]");
  if (link && back && back.startsWith("/") && !back.startsWith("//")) {
    link.href = back;
    sessionStorage.setItem("training-back", back);
  }
</script>

<style>
  .room {
    max-width: 1080px;
    margin: 0 auto;
    padding-block: 1.4rem 3rem;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .back {
    color: var(--train-ink);
    font-family: var(--font-hand);
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline wavy;
  }

  .room-head h1 {
    margin: 0;
    font-size: clamp(3.2rem, 10vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .room-head p {
    margin: 0.6rem 0 0;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .today-slot {
    max-width: 760px;
  }

  .all-title {
    margin: 0.6rem 0 1rem;
    font-size: 1.1rem;
    font-weight: 900;
  }

  .section-note {
    margin: -0.4rem 0 1rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 1.4rem 1rem;
  }

  .foot {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--train-muted);
  }
</style>
