---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectsPage from "@/components/ProjectsPage.astro";
import { t, SUPPORTED_LOCALES, DEFAULT_LOCALE, type Locale } from "@/i18n";

export async function getStaticPaths() {
  return SUPPORTED_LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params as { locale: Locale };
---

<BaseLayout title={t(locale, "projects.title")} locale={locale}>
  <ProjectsPage locale={locale} />
</BaseLayout>
