---
import PostLayout from "@/layouts/PostLayout.astro";
import { getCollection, render } from "astro:content";
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, type Locale } from "@/i18n";
import {
  estimateReadingTime,
  getPostSlug,
  getPostTranslationLinks,
  getPostsForLocale,
} from "@/utils/posts";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts", ({ data }) => !data.draft);

  return SUPPORTED_LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).flatMap((locale) =>
    getPostsForLocale(allPosts, locale).map((post) => ({
      params: { locale, slug: getPostSlug(post) },
      props: { allPosts, locale, post },
    }))
  );
}

const { allPosts, locale, post } = Astro.props as {
  allPosts: Awaited<ReturnType<typeof getCollection<"posts">>>;
  locale: Locale;
  post: Awaited<ReturnType<typeof getCollection<"posts">>>[number];
};
const { Content } = await render(post);
const readingTime = estimateReadingTime(post.body, locale);
const translationLinks = getPostTranslationLinks(allPosts, post);
---

<PostLayout post={post} readingTime={readingTime} translationLinks={translationLinks}>
  <Content />
</PostLayout>
