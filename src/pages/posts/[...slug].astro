---
import PostLayout from "@/layouts/PostLayout.astro";
import { getCollection, render } from "astro:content";
import { DEFAULT_LOCALE } from "@/i18n";
import {
  estimateReadingTime,
  getPostSlug,
  getPostTranslationLinks,
  getPostsForLocale,
} from "@/utils/posts";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts", ({ data }) => !data.draft);
  const posts = getPostsForLocale(allPosts, DEFAULT_LOCALE);

  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { allPosts, post },
  }));
}

const { allPosts, post } = Astro.props;
const { Content } = await render(post);
const readingTime = estimateReadingTime(post.body, DEFAULT_LOCALE);
const translationLinks = getPostTranslationLinks(allPosts, post);
---

<PostLayout post={post} readingTime={readingTime} translationLinks={translationLinks}>
  <Content />
</PostLayout>
