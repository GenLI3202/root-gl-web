const drawing = DRAWINGS[name];
---

<svg class="project-sketch" viewBox="0 0 200 120" aria-hidden="true">
  <g class="sketch-ink">
    {drawing.ink.map((d) => <path d={d} />)}
    {drawing.dashed?.map((d) => <path class="dashed" d={d} />)}
  </g>
  {drawing.accent && (
    <g class="sketch-accent">
      {drawing.accent.map((d) => <path d={d} />)}
    </g>
  )}
  {drawing.labels?.map((l) => (
    <text class="sketch-label" x={l.x} y={l.y} text-anchor="middle">{l.text}</text>
  ))}
</svg>

<style>
  .project-sketch {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: url(#hand-wobble);
  }

  .sketch-ink,
  .sketch-accent {
    fill: none;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sketch-ink {
    stroke: var(--fg);
  }

  .sketch-accent {
    stroke: var(--accent);
    stroke-width: 1.9;
  }

  .dashed {
    stroke-dasharray: 3 4;
    opacity: 0.7;
  }

  .sketch-label {
    font-family: var(--font-hand);
    font-size: 13px;
    font-weight: 700;
    fill: var(--accent);
  }
</style>
