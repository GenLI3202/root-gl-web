      "M29 69.2 L37 87.4 M42 66.2 L50 84.4 M20 81 L60 72",
      "M30 89 L30 100 M58 80 L58 100",
      "M76 61.6 C94 61.2 114 61.4 130 62 L130 100 M76 62 L76 100.4",
      "M86 67 L86.4 95 M96 67 L96 95.4 M110 67 L110.2 95 M120 67 L120.4 95",
      "M100 70 L96.6 79 L101 79 L98.6 88",
      "M146 100 L146 67 C146 63.6 148 62 151 62 L158 62 C161 62 162.4 64 162.4 67 L162.6 100",
      "M149.4 67.4 L159 67.2 L159.2 75.4 L149.6 75.6 L149.4 67",
      "M162.6 80 C172 82 172 92 179 92.6",
      "M178 100 L183 66 L188 100 M180 82 L186 82 M179 92 L187.4 91.6 M183 66 L183 60",
      "M84 12 C94 11.4 106 11.6 116 12.2 L116.2 32 C106 32.6 94 32.4 84.2 32 L84 11.6",
    ],
    dashed: [
      "M90 32.4 C78 40 58 48 42 64",
