---
import type { SketchName } from "@/data/projects";

/**
 * Pen-sketch cover for a project card, drawn on a 200 × 120 canvas in the page ink colour.
 * Uses the shared #hand-wobble filter from BaseLayout so lines look hand-drawn.
 */
interface Props {
  name: SketchName;
}

const { name } = Astro.props;

/** Hand-drawn circle: four Béziers that end slightly past the start */
function circle(cx: number, cy: number, r: number): string {
  const k = r * 0.56;
  return (
    `M${cx} ${cy - r} C${cx + k} ${cy - r} ${cx + r} ${cy - k} ${cx + r} ${cy} ` +
    `C${cx + r} ${cy + k} ${cx + k} ${cy + r} ${cx} ${cy + r} ` +
    `C${cx - k} ${cy + r} ${cx - r} ${cy + k} ${cx - r} ${cy} ` +
    `C${cx - r} ${cy - k} ${cx - k} ${cy - r + 0.4} ${cx + 1} ${cy - r + 0.2}`
  );
}

/** Map pin with its point at (x, y) */
function pin(x: number, y: number): string {
  return (
    `M${x} ${y} C${x - 2} ${y - 5} ${x - 8} ${y - 9} ${x - 8} ${y - 15} ` +
    `C${x - 8} ${y - 20} ${x - 4.4} ${y - 23} ${x} ${y - 23} ` +
    `C${x + 4.4} ${y - 23} ${x + 8} ${y - 20} ${x + 8} ${y - 15} ` +
    `C${x + 8} ${y - 9} ${x + 2} ${y - 5} ${x - 0.4} ${y + 0.4}`
  );
}

interface Drawing {
  ink: string[];
  dashed?: string[];
  accent?: string[];
  labels?: { x: number; y: number; text: string }[];
}

