      "M114 30 C140 36 168 46 182 60",
    ],
    labels: [{ x: 100, y: 27, text: "EMS" }],
  },
  // EV charging siting: a folded map, roads, and candidate sites
  map: {
    ink: [
      "M20 22 L70 13.6 L130 24 L180 15.4 L180.4 98 L130 106.4 L70 96 L20.4 104.4 L20 21.4",
      "M70 14 L70.4 96 M130 24 L130.2 106",
      "M24 72 C50 61 80 77 110 59 C134 45 160 61 178 49",
