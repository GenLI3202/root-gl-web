---
import { getCollection } from "astro:content";
import Seal from "@/components/Seal.astro";
import HandIcon from "@/components/HandIcon.astro";
import type { HandIconName } from "@/components/hand-icons";
import SayHello from "@/components/SayHello.astro";
import { t, localizeUrl, DEFAULT_LOCALE, type Locale } from "@/i18n";
import { NOW_ITEMS, NOW_UPDATED } from "@/data/now";
import { formatPostDate, getPostLabels, getPostUrl, getPostsForLocale } from "@/utils/posts";

interface Props {
  locale: Locale;
}

interface HomeCopy {
  hello: string;
  nameLine: string;
  intro: string;
  notebook: string;
  clockFallback: string;
  clockPrefix: string;
  clockMiddle: string;
  lately: string;
  updated: string;
  sealNote: string;
}

interface ClockStatuses {
  weekday: string[];
  weekend: string[];
}

const { locale } = Astro.props;

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const localePosts = getPostsForLocale(allPosts, locale);
// Locales without their own posts show the English ones instead of an empty list
const recentPosts = (
  localePosts.length > 0 ? localePosts : getPostsForLocale(allPosts, DEFAULT_LOCALE)
).slice(0, 4);

const COPY: Record<Locale, HomeCopy> = {
  en: {
    hello: "hi, glad you found this place",
    nameLine: "I'm Gen Li.",
    intro:
      "I'm a PhD researcher at TU Munich's Center for Energy Markets. On weekdays I teach " +
      "<span class='marker'>batteries and EV chargers</span> to make better decisions under " +
      "uncertainty. On weekends I'm on a bike somewhere south of Munich.",
    notebook:
      "This site is my notebook: research notes, rides, books, and the occasional guitar evening.",
    clockFallback: "Written from Munich, Germany.",
    clockPrefix: "It's",
    clockMiddle: "in Munich. I'm probably",
    lately: "Lately",
    updated: "updated",
    sealNote: "my name, stamped",
  },
  zh: {
    hello: "你好，欢迎来坐坐",
    nameLine: "我是李根。",
    intro:
      "慕尼黑工业大学能源市场中心的博士研究员。工作日教" +
      "<span class='marker'>电池和充电桩</span>在不确定性下做更好的决策；" +
      "周末多半在慕尼黑以南的某条路上骑车。",
    notebook: "这个网站是我的笔记本：研究、骑行、读书，偶尔还有一晚吉他。",
    clockFallback: "写于德国慕尼黑。",
    clockPrefix: "慕尼黑现在是",
    clockMiddle: "，我大概正在",
    lately: "最近",
    updated: "更新于",
    sealNote: "我的名章",
  },
  de: {
    hello: "hallo, schön, dass du hier bist",
    nameLine: "Ich bin Gen Li.",
    intro:
      "Ich forsche als Doktorand am Center for Energy Markets der TU München. Unter der Woche " +
      "bringe ich <span class='marker'>Batterien und Ladesäulen</span> bei, unter Unsicherheit " +
      "bessere Entscheidungen zu treffen. Am Wochenende sitze ich irgendwo südlich von München " +
      "auf dem Rad.",
    notebook:
      "Diese Seite ist mein Notizbuch: Forschung, Ausfahrten, Bücher und ab und zu ein Gitarrenabend.",
    clockFallback: "Geschrieben in München.",
    clockPrefix: "In München ist es",
    clockMiddle: ". Wahrscheinlich bin ich gerade",
    lately: "Gerade",
    updated: "aktualisiert",
    sealNote: "mein Namensstempel",
  },
};

/*
 * Guesses for what Gen is doing, indexed by hour band in Munich time:
 * [0–6, 6–8, 8–12, 12–14, 14–18, 18–21, 21–24]
 */
const CLOCK_STATUSES: Record<Locale, ClockStatuses> = {
  en: {
    weekday: [
      "asleep (or should be).",
      "out for an early ride along the Isar.",
      "deep in a solver log.",
      "at lunch, talking about electricity prices.",
      "writing code or a paper draft.",
      "on the bike, or reading.",
      "playing guitar instead of answering email.",
    ],
    weekend: [
      "asleep (or should be).",
      "pumping up tyres for a group ride.",
      "on a group ride somewhere south of Munich.",
      "on a group ride somewhere south of Munich.",
      "recovering from the ride with a book.",
      "reading, or planning the next route.",
      "playing guitar instead of answering email.",
    ],
  },
  zh: {
    weekday: [
      "睡觉（或者应该在睡觉）。",
      "沿着伊萨尔河晨骑。",
      "盯着求解器的日志发呆。",
      "吃午饭，顺便聊电价。",
      "写代码，或者改论文。",
      "骑车，或者看书。",
      "弹吉他，邮件明天再回。",
    ],
    weekend: [
      "睡觉（或者应该在睡觉）。",
      "给轮胎打气，准备团骑。",
      "在慕尼黑以南的某条路上团骑。",
      "在慕尼黑以南的某条路上团骑。",
      "骑完车，捧着书恢复体力。",
      "看书，或者规划下一条路线。",
      "弹吉他，邮件明天再回。",
    ],
  },
  de: {
    weekday: [
      "am Schlafen (oder sollte es sein).",
      "auf einer frühen Runde an der Isar.",
      "tief in einem Solver-Log.",
      "beim Mittagessen und rede über Strompreise.",
      "am Programmieren oder an einem Paper.",
      "auf dem Rad oder am Lesen.",
      "an der Gitarre statt im Posteingang.",
    ],
    weekend: [
      "am Schlafen (oder sollte es sein).",
      "am Reifenaufpumpen für die Gruppenausfahrt.",
      "auf einer Gruppenausfahrt südlich von München.",
      "auf einer Gruppenausfahrt südlich von München.",
      "mit einem Buch am Erholen.",
      "am Lesen oder plane die nächste Route.",
      "an der Gitarre statt im Posteingang.",
    ],
  },
};

const PROJECTS = [
  {
    title: "MAMODA Web Dashboard",
    description: {
      en: "Interactive knowledge hub for sustainable mining decisions. Multi-objective optimization with stakeholder-guided decision-making.",
      zh: "可持续采矿决策的交互式知识平台，融合多目标优化与利益相关方引导决策。",
      de: "Interaktive Wissensplattform für nachhaltige Bergbauentscheidungen mit Multi-Ziel-Optimierung.",
    },
    tags: ["Python", "FastAPI", "Plotly"],
    href: "https://mamoda-web-dashboard.vercel.app/",
  },
  {
    title: "ACC ClubHub",
    description: {
      en: "Digital hub for Accross Cycling Club Munich: events, routes, gear guides, and training notes.",
      zh: "慕尼黑 Accross 骑行俱乐部的线上基地：活动、路线、装备指南和训练笔记。",
      de: "Digitaler Treffpunkt des Accross Cycling Club München: Events, Routen, Ausrüstung und Training.",
    },
    tags: ["Astro", "TypeScript"],
    href: "https://www.across-cc.de/",
  },
  {
    title: "EV Charging Optimizer",
    description: {
      en: "Stochastic MILP model for optimal EV charging station placement under grid uncertainty. PCT patent WO2025026594.",
      zh: "基于随机混合整数规划的电动汽车充电站选址优化模型，PCT 专利 WO2025026594。",
      de: "Stochastisches MILP-Modell für optimale EV-Ladestation-Platzierung. PCT-Patent WO2025026594.",
    },
    tags: ["Python", "Pyomo", "CPLEX"],
    href: "https://patentscope.wipo.int/search/en/detail.jsf?docId=WO2025026594",
  },
];

interface IdentityTag {
  icon: HandIconName;
  label: string;
  title: string;
  href: string;
}

const IDENTITY_TAGS: Record<Locale, IdentityTag[]> = {
  en: [
    { icon: "bolt", label: "Energy Research", title: "Energy systems optimization", href: "/about/" },
    { icon: "bike", label: "Cyclist", title: "Accross Cycling Club Munich", href: "/hobbies/" },
    { icon: "book", label: "Reader", title: "Sci-fi, Wuxia, Literature", href: "/hobbies/" },
    { icon: "guitar", label: "Guitar", title: "Acoustic guitar", href: "/hobbies/" },
  ],
  zh: [
    { icon: "bolt", label: "能源研究", title: "能源系统优化", href: "/zh/about/" },
    { icon: "bike", label: "骑行者", title: "Accross骑行俱乐部慕尼黑", href: "/zh/hobbies/" },
    { icon: "book", label: "读书人", title: "科幻、武侠、文学", href: "/zh/hobbies/" },
    { icon: "guitar", label: "吉他", title: "民谣木吉他", href: "/zh/hobbies/" },
  ],
  de: [
    { icon: "bolt", label: "Energieforschung", title: "Energiesystemoptimierung", href: "/de/about/" },
    { icon: "bike", label: "Radfahrer", title: "Accross Cycling Club München", href: "/de/hobbies/" },
    { icon: "book", label: "Leser", title: "Sci-Fi, Wuxia, Literatur", href: "/de/hobbies/" },
    { icon: "guitar", label: "Gitarre", title: "Akustikgitarre", href: "/de/hobbies/" },
  ],
};

const copy = COPY[locale];
const nowItems = NOW_ITEMS[locale];
const [nowYear, nowMonth] = NOW_UPDATED.split("-").map(Number);
const nowUpdatedLabel = new Intl.DateTimeFormat(
  { en: "en-GB", zh: "zh-CN", de: "de-DE" }[locale],
  { month: "short", year: "numeric" }
).format(new Date(nowYear, nowMonth - 1, 1));

function isExternal(href: string): boolean {
  return /^https?:\/\//.test(href);
}
---

<!-- ── Hero ─────────────────────────────── -->
<section class="hero">
  <div class="container">
    <p class="hero-hello hand">
      {copy.hello}
      <svg class="hello-arrow" viewBox="0 0 60 40" aria-hidden="true">
        <path d="M4 6 C 22 4, 40 12, 46 30" />
        <path d="M38 26 L 46 31 L 50 22" />
      </svg>
    </p>

    <div class="hero-name-row">
      <h1 class="hero-name">{copy.nameLine}</h1>
      <span class="hero-seal" title={copy.sealNote}>
        <Seal size={46} tilt={-5} />
      </span>
    </div>

    <p class="hero-intro" set:html={copy.intro} />
    <p class="hero-notebook">{copy.notebook}</p>

    <p
      class="hero-clock"
      data-munich-clock
      data-locale={locale}
      data-prefix={copy.clockPrefix}
      data-middle={copy.clockMiddle}
      data-statuses={JSON.stringify(CLOCK_STATUSES[locale])}
    >
      <span class="clock-dot" aria-hidden="true"></span>
      <span class="clock-text">{copy.clockFallback}</span>
    </p>

    <div class="hero-tags">
      {IDENTITY_TAGS[locale].map(({ icon, label, title, href }) => (
        <a class="identity-tag" href={href} title={title}>
          <HandIcon name={icon} size={16} />
          {label}
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ── Lately ───────────────────────────── -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{copy.lately}</h2>
      <span class="now-stamp hand">{copy.updated} {nowUpdatedLabel}</span>
    </div>

    <ul class="now-grid" role="list">
      {nowItems.map((item, index) => {
        const Tag = item.href ? "a" : "div";
        const external = item.href ? isExternal(item.href) : false;
        return (
          <li class="now-card" style={`--card-tilt: ${index % 2 === 0 ? -0.6 : 0.5}deg;`}>
            <Tag
              class="now-link"
              href={item.href}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
            >
              <span class="now-icon"><HandIcon name={item.icon} size={30} /></span>
              <span class="now-label">{item.label}</span>
              <span class="now-text">{item.text}</span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<!-- ── Recent Posts ──────────────────────── -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t(locale, "index.writing.title")}</h2>
      <a href={localizeUrl("/posts/", locale)} class="section-link">
        {t(locale, "index.writing.link")}
      </a>
    </div>

    {recentPosts.length === 0 ? (
      <p class="empty-state">{getPostLabels(locale).empty}</p>
    ) : (
      <ul class="post-list" role="list">
        {recentPosts.map((post) => (
          <li class="post-item">
            <a href={getPostUrl(post)} class="post-link">
              <span class="post-date">{formatPostDate(post.data.pubDate, locale)}</span>
              <span class="post-body">
                <span class="post-title">{post.data.title}</span>
                {post.data.description && (
                  <span class="post-desc">{post.data.description}</span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<!-- ── Selected Projects ─────────────────── -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t(locale, "index.projects.title")}</h2>
      <a href={localizeUrl("/projects/", locale)} class="section-link">
        {t(locale, "index.projects.link")}
      </a>
    </div>

    <ul class="project-list" role="list">
      {PROJECTS.map((project) => (
        <li class="project-card">
          <a href={project.href} class="project-link" target="_blank" rel="noopener noreferrer">
            <div class="project-content">
              <h3 class="project-title">{project.title}</h3>
              <p class="project-desc">{project.description[locale]}</p>
              <div class="project-tags">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
            <span class="project-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<SayHello locale={locale} />

<script>
  interface ClockStatuses {
    weekday: string[];
    weekend: string[];
  }

  const HOUR_BANDS = [6, 8, 12, 14, 18, 21, 24];
  const DATE_LOCALES: Record<string, string> = { en: "en-GB", zh: "zh-CN", de: "de-DE" };
  let clockTimer: number | undefined;

  function bandIndex(hour: number): number {
    return HOUR_BANDS.findIndex((limit) => hour < limit);
  }

  function renderClock(el: HTMLElement): void {
    const locale = el.dataset.locale ?? "en";
    const statuses = JSON.parse(el.dataset.statuses ?? "{}") as ClockStatuses;
    const now = new Date();
    const parts = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Europe/Berlin",
      hour: "2-digit",
      minute: "2-digit",
      weekday: "short",
      hour12: false,
    }).formatToParts(now);
    const hour = Number(parts.find((p) => p.type === "hour")?.value ?? 12) % 24;
    const weekday = parts.find((p) => p.type === "weekday")?.value ?? "Mon";
    const isWeekend = weekday === "Sat" || weekday === "Sun";
    const time = new Intl.DateTimeFormat(DATE_LOCALES[locale], {
      timeZone: "Europe/Berlin",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    }).format(now);
    const list = isWeekend ? statuses.weekend : statuses.weekday;
    const status = list?.[bandIndex(hour)] ?? "";
    const text = el.querySelector(".clock-text");
    if (!text) return;
    const sep = locale === "zh" ? "" : " ";
    const middle = el.dataset.middle ?? "";
    const middleSep = middle.startsWith(".") || middle.startsWith("，") ? "" : sep;
    text.innerHTML =
      `${el.dataset.prefix}${sep}<strong>${time}</strong>${middleSep}${middle}${sep}${status}`;
    el.classList.add("is-live");
  }

  function initClock(): void {
    window.clearInterval(clockTimer);
    const el = document.querySelector<HTMLElement>("[data-munich-clock]");
    if (!el) return;
    renderClock(el);
    clockTimer = window.setInterval(() => renderClock(el), 30_000);
  }

  document.addEventListener("astro:page-load", initClock);
</script>

<style>
  /* ── Hero ── */
  .hero {
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
  }

  .hero-hello {
    position: relative;
    display: inline-block;
    font-size: 1.6rem;
    transform: rotate(-2deg);
    margin-bottom: 0.25rem;
    margin-left: -0.15rem;
  }

  .hello-arrow {
    position: absolute;
    right: -3.6rem;
    top: 0.6rem;
    width: 3.2rem;
    height: 2.2rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-name-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .hero-name {
    font-size: var(--text-hero);
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .hero-seal {
    display: inline-flex;
    cursor: default;
  }

  .hero-seal:hover :global(.seal) {
    transform: rotate(4deg) scale(1.06);
  }

  .hero-intro {
    font-size: var(--text-lg);
    line-height: 1.75;
    max-width: 38rem;
    margin-bottom: 0.75rem;
  }

  .hero-notebook {
    font-size: var(--text-base);
    color: var(--fg-muted);
    max-width: 38rem;
    margin-bottom: 1.5rem;
  }

  .hero-clock {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
    margin-bottom: 1.75rem;
  }

  .hero-clock :global(strong) {
    color: var(--fg);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .clock-dot {
    position: relative;
    top: -0.05rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--border-dark);
    flex-shrink: 0;
  }

  .hero-clock.is-live .clock-dot {
    background: var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 var(--accent-soft); }
    50% { box-shadow: 0 0 0 0.35rem var(--accent-soft); }
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .identity-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--fg-muted);
    text-decoration: none;
    transition: border-color var(--transition), color var(--transition),
      transform 250ms var(--ease-out);
  }

  .identity-tag:hover {
    border-color: var(--accent);
    color: var(--fg);
    transform: translateY(-2px) rotate(-1deg);
  }

  /* ── Sections ── */
  .section {
    padding-block: 2.75rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    gap: 1rem;
  }

  .section-title {
    font-size: var(--text-xl);
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .section-link {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition);
  }

  .section-link:hover {
    color: var(--accent);
  }

  .empty-state {
    color: var(--fg-muted);
    font-style: italic;
  }

  /* ── Lately ── */
  .now-stamp {
    font-size: 1.15rem;
    color: var(--fg-muted);
    transform: rotate(-2deg);
    white-space: nowrap;
  }

  .now-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .now-card {
    transform: rotate(var(--card-tilt));
    transition: transform 300ms var(--ease-out);
  }

  .now-card:hover {
    transform: rotate(0deg) translateY(-3px);
  }

  .now-link {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto 1fr;
    column-gap: 0.75rem;
    row-gap: 0.25rem;
    height: 100%;
    padding: 1rem 1.1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  a.now-link:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-hover);
  }

  .now-icon {
    grid-row: 1 / 3;
    color: var(--fg);
    padding-top: 0.1rem;
  }

  a.now-link:hover .now-icon {
    color: var(--accent);
  }

  .now-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .now-text {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--fg);
  }

  /* ── Post list ── */
  .post-list {
    list-style: none;
  }

  .post-item {
    border-bottom: 1px dashed var(--border-dark);
  }

  .post-link {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    text-decoration: none;
  }

  .post-date {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    padding-top: 0.1rem;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .post-title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--fg);
    transition: color var(--transition);
  }

  .post-desc {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-link:hover .post-title {
    color: var(--accent);
  }

  /* ── Project list ── */
  .project-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .project-card {
    border-bottom: 1px dashed var(--border-dark);
