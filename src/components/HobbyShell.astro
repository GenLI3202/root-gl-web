---
import HandIcon from "@/components/HandIcon.astro";
import { t, localizeUrl, type Locale } from "@/i18n";
import { HOBBIES, type HobbyId } from "@/data/hobbies";

/**
 * Frame for one hobby sub-page: back link, switcher between hobbies, header with
 * illustration, the page's own sections (default slot), and a link to the next hobby.
 */
interface Props {
  locale: Locale;
  hobby: HobbyId;
  kicker: string;
  lead: string;
  illustration: string;
}

const BACK: Record<Locale, string> = {
  en: "All hobbies",
  zh: "全部爱好",
  de: "Alle Hobbys",
};

const NEXT: Record<Locale, string> = {
  en: "Next",
  zh: "下一个",
  de: "Weiter",
};

const { locale, hobby, kicker, lead, illustration } = Astro.props;
const index = HOBBIES.findIndex((h) => h.id === hobby);
const next = HOBBIES[(index + 1) % HOBBIES.length];
const hobbyUrl = (id: HobbyId): string => localizeUrl(`/hobbies/${id}/`, locale);
---

<div class="hobby-page">
  <nav class="hobby-nav container-wide" aria-label={t(locale, "nav.hobbies")}>
    <a class="hobby-back" href={localizeUrl("/hobbies/", locale)}>← {BACK[locale]}</a>
    <ul class="hobby-switch" role="list">
      {HOBBIES.map(({ id, icon }) => (
        <li>
          <a
            href={hobbyUrl(id)}
            class:list={["switch-link", { current: id === hobby }]}
            aria-current={id === hobby ? "page" : undefined}
          >
            <HandIcon name={icon} size={16} />
            {t(locale, `hobbies.${id}.label`)}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <header class="hobby-header container-wide">
    <div class="hobby-header-text">
      <p class="hobby-kicker hand">{kicker}</p>
      <h1 class="hobby-title">{t(locale, `hobbies.${hobby}.label`)}</h1>
      <p class="hobby-lead" set:html={lead} />
      <slot name="header-extra" />
    </div>
    <img class="hobby-illustration" src={illustration} alt="" aria-hidden="true" />
  </header>

  <div class="hobby-body container-wide">
    <slot />
  </div>

  <footer class="hobby-footer container-wide">
    <a class="next-link" href={hobbyUrl(next.id)}>
      <span class="next-label">{NEXT[locale]}</span>
      <span class="next-title">
        <HandIcon name={next.icon} size={20} />
        {t(locale, `hobbies.${next.id}.label`)} →
      </span>
    </a>
  </footer>
</div>

<style>
  .hobby-page {
    padding-block: 2rem 1rem;
  }

  .container-wide {
    max-width: var(--wide-width);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  /* ── Top navigation ── */
  .hobby-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 2.5rem;
  }

  .hobby-back {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .hobby-back:hover {
    color: var(--accent);
  }

  .hobby-switch {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .switch-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    text-decoration: none;
    transition: border-color var(--transition), color var(--transition);
  }

  .switch-link:hover {
    border-color: var(--accent);
    color: var(--fg);
  }

  .switch-link.current {
    border-color: var(--fg);
    color: var(--fg);
    background: var(--surface);
  }

  /* ── Header ── */
  .hobby-header {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .hobby-kicker {
    font-size: 1.4rem;
    transform: rotate(-2deg);
    transform-origin: left;
    margin-bottom: 0.25rem;
  }

  .hobby-title {
    font-size: var(--text-hero);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-bottom: 1.25rem;
  }

  .hobby-lead {
    font-size: var(--text-lg);
    line-height: 1.75;
    max-width: 38rem;
  }

  .hobby-illustration {
    width: 100%;
    max-height: 280px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.85;
  }

  :global(.theme-dark) .hobby-illustration {
    filter: grayscale(1) invert(1);
    opacity: 0.6;
  }

  /* ── Body: each page stacks its own sections ── */
  .hobby-body {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  /* ── Footer link to the next hobby ── */
  .hobby-footer {
    margin-top: 4rem;
  }

  .next-link {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border-dark);
    text-decoration: none;
    color: var(--fg);
  }

  .next-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .next-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    transition: color var(--transition);
  }

  .next-link:hover .next-title {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .hobby-header {
      grid-template-columns: 1fr;
    }

    .hobby-illustration {
      order: -1;
      max-height: 180px;
    }
  }
</style>
