---
import type { Locale } from "@/i18n";
import BookDialog from "@/components/BookDialog.astro";
import StudyBookcase, { type CaseShape } from "@/components/StudyBookcase.astro";
import StudyScene from "@/components/StudyScene.astro";
import { CATEGORY_LABELS, CATEGORY_ORDER, type BookCategory } from "@/data/books";
import { LIBRARY, toHours, type ShelfBook } from "@/data/library";

/**
 * The reading room: a small 3D study with one rosewood bookcase per category. Picking a
 * bookcase moves the camera up to it and fades to a close-up of its shelves; picking a spine
 * there opens the book's dialog.
 */
interface Props {
  locale: Locale;
}

interface RoomCopy {
  heading: string;
  hint: string;
  back: string;
  legend: string;
  total: (count: number) => string;
  count: (count: number) => string;
}

interface Bookcase {
  category: BookCategory;
  books: ShelfBook[];
}

const { locale } = Astro.props;

const COPY: Record<Locale, RoomCopy> = {
  en: {
    heading: "The reading room",
    hint: "pick a bookcase to step closer",
    back: "Back to the room",
    legend: "Thicker spine, more hours read. Red ribbon: read in the last 30 days.",
    total: (n) => `${n} books`,
    count: (n) => `${n} books`,
  },
  zh: {
    heading: "书房",
    hint: "点一个书架，走近看看",
    back: "回到书房",
    legend: "书脊越厚，读得越久。红签：最近 30 天读过。",
    total: (n) => `${n} 本书`,
    count: (n) => `${n} 本`,
  },
  de: {
    heading: "Das Lesezimmer",
    hint: "wähl ein Regal und tritt näher",
    back: "Zurück ins Zimmer",
    legend: "Dickerer Rücken, mehr Lesestunden. Rotes Band: in den letzten 30 Tagen gelesen.",
    total: (n) => `${n} Bücher`,
    count: (n) => `${n} Bücher`,
  },
};

/** Tall cases stand along the back wall; the two smallest are low cabinets at the front */
const CASE_SHAPES: Record<BookCategory, CaseShape> = {
  literature: { w: 26, h: 36, d: 8 },
  ideas: { w: 16, h: 36, d: 8 },
  polecon: { w: 15, h: 36, d: 8 },
  wuxia: { w: 16, h: 15, d: 9 },
  scifi: { w: 14, h: 15, d: 9 },
};

// Spine heights cycle so a shelf looks hand-stacked, not uniform
const SPINE_HEIGHTS = [150, 134, 158, 140, 128, 152, 138];
const MAX_SPINE_HEIGHT = 196;

const copy = COPY[locale];
/** Tab order through the room follows where cases stand: back row left to right, then front */
const ROOM_ORDER: BookCategory[] = ["ideas", "literature", "polecon", "wuxia", "scifi"];

const bookcases: Bookcase[] = CATEGORY_ORDER.map((category) => ({
  category,
  books: LIBRARY.filter((b) => b.category === category),
})).filter((c) => c.books.length > 0);
const roomCases: Bookcase[] = [...bookcases].sort(
  (a, b) => ROOM_ORDER.indexOf(a.category) - ROOM_ORDER.indexOf(b.category)
);
const maxSeconds = Math.max(0, ...LIBRARY.map((b) => b.reading?.seconds ?? 0));

const CJK = /[㐀-鿿]/;

function spineWidth(book: ShelfBook): number {
  if (!book.reading || maxSeconds === 0) return 40;
  return Math.round(34 + 26 * Math.sqrt(book.reading.seconds / maxSeconds));
}

/** Cycled height, raised so the vertical title and the hours label both fit */
function spineHeight(book: ShelfBook, index: number): number {
  const perChar = CJK.test(book.title) ? 17 : 8.5;
  const needed = book.title.length * perChar + (book.reading ? 58 : 34);
  return Math.min(MAX_SPINE_HEIGHT, Math.max(SPINE_HEIGHTS[index % SPINE_HEIGHTS.length], needed));
}
---

<section class="reading-room" data-reading-room aria-labelledby="room-heading">
  <div class="room-head">
    <h2 class="room-heading" id="room-heading">{copy.heading}</h2>
    <p class="room-hint hand">{copy.total(LIBRARY.length)} · {copy.hint}</p>
  </div>

  <div class="room-stage" data-stage>
    <div class="room" data-room>
      <StudyScene>
        {roomCases.map(({ category, books }) => (
          <button
            type="button"
            class="case"
            data-open-case={category}
            data-case-h={CASE_SHAPES[category].h}
            aria-label={`${CATEGORY_LABELS[category][locale]}, ${copy.count(books.length)}`}
            aria-controls={`case-${category}`}
            aria-expanded="false"
            style={`--spine: var(--shelf-${category});`}
          >
            <StudyBookcase
              category={category}
              books={books}
              maxSeconds={maxSeconds}
              shape={CASE_SHAPES[category]}
              label={CATEGORY_LABELS[category][locale]}
              count={copy.count(books.length)}
              orchid={category === "scifi"}
            />
          </button>
        ))}
      </StudyScene>
    </div>

    {bookcases.map(({ category, books }) => (
      <section
        class="case-view"
        id={`case-${category}`}
        data-case-view={category}
        aria-labelledby={`case-${category}-title`}
        style={`--spine: var(--shelf-${category});`}
        hidden
      >
        <div class="case-head">
          <button type="button" class="case-back" data-close-case>← {copy.back}</button>
          <h3 class="case-title" id={`case-${category}-title`} tabindex="-1">
            {CATEGORY_LABELS[category][locale]}
            <span class="case-count hand">{copy.count(books.length)}</span>
          </h3>
          <p class="case-legend">{copy.legend}</p>
        </div>
        <ul class="case-shelf" role="list">
          {books.map((book, i) => (
            <li class="case-slot">
              <button
                type="button"
                class="spine"
                data-open-book={book.id}
                aria-haspopup="dialog"
                aria-controls={`book-${book.id}`}
                style={`--spine-w: ${spineWidth(book)}px; --spine-h: ${spineHeight(book, i)}px;`}
              >
                {book.recent && <span class="spine-ribbon" aria-hidden="true"></span>}
                <span class="spine-title" lang={CJK.test(book.title) ? "zh" : undefined}>
                  {book.title}
                </span>
                {book.reading && (
                  <span class="spine-hours hand">{toHours(book.reading.seconds)}h</span>
                )}
              </button>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  {LIBRARY.map((book) => <BookDialog book={book} locale={locale} />)}
</section>

<script>
  const CAMERA_MS = 700;
  const FADE_OUT_MS = 480;
  /** How much of the stage height the picked bookcase fills at the end of the camera move */
  const FILL = 0.92;
  const MAX_MAGNIFY = 3;

  /** Reads a unitless custom property as a number */
  function numberVar(style: CSSStyleDeclaration, name: string): number {
    return parseFloat(style.getPropertyValue(name)) || 0;
  }

  function initReadingRoom(): void {
    const root = document.querySelector<HTMLElement>("[data-reading-room]");
    if (!root) return;

    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const room = root.querySelector<HTMLElement>("[data-room]")!;
    const world = root.querySelector<HTMLElement>("[data-world]")!;
    const views = Array.from(root.querySelectorAll<HTMLElement>("[data-case-view]"));
    const cases = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-open-case]"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const CAMERA_VARS = ["--cam-x", "--cam-y", "--cam-tz", "--cam-ry", "--cam-z"];

    let openView: HTMLElement | null = null;
    let trigger: HTMLButtonElement | null = null;
    let timer = 0;

    /**
     * Moves the camera rig so the bookcase's front face turns square to the viewer at eye level
     * and fills most of the stage height; `is-flying` lowers the eye to the stage middle.
     */
    function aimCamera(button: HTMLButtonElement): void {
      const scene = getComputedStyle(world);
      const spot = getComputedStyle(button);
      const p = numberVar(scene, "--P");
      const floor = numberVar(scene, "--floor");
      const stageH = numberVar(scene, "--stage-h");
      const h = Number(button.dataset.caseH) || 20;
      const magnify = Math.min(MAX_MAGNIFY, (stageH * FILL) / h);
      const camera: Record<string, number> = {
        "--cam-x": -numberVar(spot, "--x"),
        "--cam-y": -(floor - h / 2),
        "--cam-tz": -numberVar(spot, "--z"),
        "--cam-ry": -numberVar(spot, "--ry"),
        "--cam-z": p * (1 - 1 / magnify),
      };
      Object.entries(camera).forEach(([name, value]) =>
        world.style.setProperty(name, value.toFixed(2))
      );
      stage.classList.add("is-flying");
    }

    function resetCamera(): void {
      CAMERA_VARS.forEach((name) => world.style.removeProperty(name));
      stage.classList.remove("is-flying");
    }

    function open(button: HTMLButtonElement): void {
      const view = views.find((v) => v.dataset.caseView === button.dataset.openCase);
      if (!view || openView) return;

      window.clearTimeout(timer);
      views.forEach((v) => (v.hidden = v !== view));
      cases.forEach((c) => c.classList.toggle("is-target", c === button));
      button.setAttribute("aria-expanded", "true");
      openView = view;
      trigger = button;

      if (!reduceMotion.matches) aimCamera(button);
      void view.offsetWidth; // start the fade-in from the hidden state
      stage.classList.add("is-zoomed");
      room.inert = true;

      if (stage.getBoundingClientRect().top < 0) {
        stage.scrollIntoView({
          behavior: reduceMotion.matches ? "auto" : "smooth",
          block: "start",
        });
      }
      timer = window.setTimeout(
        () => view.querySelector<HTMLElement>(".case-title")?.focus({ preventScroll: true }),
        reduceMotion.matches ? 0 : CAMERA_MS
      );
    }

    function close(): void {
      if (!openView || !trigger) return;
      const view = openView;
      const button = trigger;
      openView = null;
      trigger = null;

      window.clearTimeout(timer);
      resetCamera();
      stage.classList.remove("is-zoomed");
      room.inert = false;
      button.setAttribute("aria-expanded", "false");
      button.focus({ preventScroll: true });
      timer = window.setTimeout(
        () => {
          view.hidden = true;
          button.classList.remove("is-target");
        },
        reduceMotion.matches ? 0 : FADE_OUT_MS
      );
    }

    cases.forEach((c) => c.addEventListener("click", () => open(c)));
    root
      .querySelectorAll<HTMLButtonElement>("[data-close-case]")
      .forEach((b) => b.addEventListener("click", close));

    root.querySelectorAll<HTMLButtonElement>("[data-open-book]").forEach((spine) =>
      spine.addEventListener("click", () => {
        const dialog = document.getElementById(`book-${spine.dataset.openBook}`);
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      })
    );

    // A click on the dialog element itself landed on the backdrop
    root.querySelectorAll<HTMLDialogElement>("dialog").forEach((dialog) =>
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      })
    );

    // Escape steps back out of the close-up; an open dialog handles its own Escape first
    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && openView && !root.querySelector("dialog[open]")) close();
    });
  }

  document.addEventListener("astro:page-load", initReadingRoom);
</script>

<style>
  .reading-room {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .room-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .room-heading {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
  }

  .room-hint {
    font-size: 1.2rem;
    color: var(--accent);
  }

  /* Room and close-up share one grid cell, so one can fade into the other in place */
  .room-stage {
    container: room / inline-size;
    display: grid;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .room,
  .case-view {
    grid-area: 1 / 1;
  }

  /* ── Room ── */
  .room {
    transition: opacity 300ms ease;
  }

  .room-stage.is-zoomed .room {
    opacity: 0;
    transition: opacity 320ms ease 420ms;
  }

  /* Everything but the picked bookcase thins out while the camera moves in */
  .room-stage.is-zoomed :global(.study-fade),
  .room-stage.is-zoomed :global(.tea-table) :global(.box-face),
  .room-stage.is-zoomed :global(.tea-set),
  .room-stage.is-zoomed .case:not(.is-target) :global(.box-face),
  .room-stage.is-zoomed .case:not(.is-target) :global(.case-orchid) {
    opacity: 0;
  }

  .room-stage.is-zoomed :global(.study-fade) {
    opacity: 0.35;
  }

  /*
   * Where each bookcase stands: x and z of its front face in room units, turned by --ry.
   * Tall cases line the back wall; the low cabinets sit forward, angled toward the middle.
   */
  .case {
    --lift: 0;
    --depth-k: calc((var(--P) - var(--z)) / var(--P));

    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    transform-style: preserve-3d;
    transform: translate3d(
        calc(var(--x) * var(--u)),
        calc(var(--floor) * var(--u)),
        calc((var(--z) + var(--lift)) * var(--u))
      )
      rotateY(calc(var(--ry) * 1deg));
    transition: transform 320ms var(--ease-out);
  }

  .case[data-open-case="ideas"] {
    --x: -40;
    --z: -42;
    --ry: 0;
  }

  .case[data-open-case="literature"] {
    --x: -6;
    --z: -42;
    --ry: 0;
  }

  .case[data-open-case="polecon"] {
    --x: 41.5;
    --z: -42;
    --ry: 0;
  }

  .case[data-open-case="wuxia"] {
    --x: -38;
    --z: 2;
    --ry: 26;
  }

  .case[data-open-case="scifi"] {
    --x: 39;
    --z: 2;
    --ry: -26;
  }

  @container room (max-width: 560px) {
    .case[data-open-case="ideas"] {
      --x: -23;
    }

    .case[data-open-case="literature"] {
      --x: 0;
    }

    .case[data-open-case="polecon"] {
      --x: 22.5;
    }

    .case[data-open-case="wuxia"] {
      --x: -12.5;
      --z: 6;
      --ry: 14;
    }

    .case[data-open-case="scifi"] {
      --x: 12.5;
      --z: 6;
      --ry: -14;
    }
  }

  .case:hover {
    --lift: 1.4;
  }

  .case:active {
    --lift: 0.5;
  }

  .case:focus-visible {
    outline: none;
  }

  /* Rings sit inside the front face; outside it they would hide behind the case's own sides */
  .case:hover :global(.box-front),
  .case:focus-visible :global(.box-front) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .case:focus-visible :global(.box-front) {
    outline-width: 3px;
    outline-offset: -3px;
  }

  /* ── Close-up of one bookcase ── */
  .case-view {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-self: start;
    padding: 1rem;
    opacity: 0;
    transform: scale(0.96) translateY(10px);
    pointer-events: none;
    transition:
      opacity 260ms ease,
      transform 360ms var(--ease-out);
  }

  .case-view[hidden] {
    display: none;
  }

  .room-stage.is-zoomed .case-view {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition:
      opacity 320ms ease 520ms,
      transform 420ms var(--ease-out) 520ms;
  }

  .case-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .case-back {
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    padding: 0.3rem 0.8rem;
    color: var(--fg-muted);
    background: var(--bg);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition);
  }

  .case-back:hover,
  .case-back:focus-visible {
    border-color: var(--fg);
    color: var(--fg);
  }

  .case-back:active {
    transform: scale(0.97);
  }

  .case-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    outline: none;
  }

  .case-count {
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--fg-muted);
  }

  .case-legend {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /*
   * The bookcase seen square-on: a rosewood frame, cornice and base around dark recessed shelves.
   * Each row is one shelf; the gradient draws a plank under every row.
   */
  .case-shelf {
    --row: 216px;
    --plank: 9px;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    padding: 0 0.75rem;
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0 calc(var(--row) - var(--plank)),
        var(--wood-top) calc(var(--row) - var(--plank)) calc(var(--row) - var(--plank) + 2px),
        var(--wood) calc(var(--row) - var(--plank) + 2px) var(--row)
      ),
      linear-gradient(to bottom, var(--wood-line), transparent 3.5rem),
      var(--wood-recess);
    border: 10px solid var(--wood);
    border-top-width: 18px;
    border-bottom-width: 14px;
    border-radius: var(--radius-sm);
    box-shadow:
      inset 0 0 0 1px var(--wood-line),
      0 -2px 0 var(--wood-top);
  }

  .case-slot {
    display: flex;
    align-items: flex-end;
    height: var(--row);
    padding: 0 2px var(--plank);
  }

  .spine {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: var(--spine-w);
    height: var(--spine-h);
    padding: 0.8rem 0 0.55rem;
    background: var(--spine);
    border: 1.5px solid var(--wood-line);
    border-bottom: none;
    border-radius: 3px 3px 0 0;
    color: var(--fg);
    font: inherit;
    cursor: pointer;
    transition:
      transform 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out);
  }

  /* Two thin bands near the top and bottom, like printed spine decoration */
  .spine::before,
  .spine::after {
    content: "";
    position: absolute;
    left: 0.35rem;
    right: 0.35rem;
    height: 0;
    border-top: 1px solid var(--fg);
    opacity: 0.35;
  }

  .spine::before {
    top: 0.4rem;
  }

  .spine::after {
    bottom: 0.3rem;
  }

  .spine:hover,
  .spine:focus-visible {
    transform: translateY(-8px) rotate(-1.5deg);
    box-shadow: var(--shadow-hover);
  }

  .spine:focus-visible {
    outline-color: var(--accent);
  }

  .spine:active {
    transform: translateY(-4px);
  }

  .spine-title {
    writing-mode: vertical-rl;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .spine-title:lang(zh) {
    font-family: var(--font-cjk);
    letter-spacing: 0.2em;
  }

  .spine-hours {
    font-size: 1rem;
    line-height: 1;
    color: var(--fg-muted);
  }

  .spine-ribbon {
    position: absolute;
    top: -0.9rem;
    right: 0.45rem;
    width: 0.45rem;
    height: 1.6rem;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
  }

  /* Reduced motion: no camera move, only a short crossfade between room and close-up */
  @media (prefers-reduced-motion: reduce) {
    .room,
    .room-stage.is-zoomed .room,
    .case-view,
    .room-stage.is-zoomed .case-view {
      transform: none;
      transition: opacity 180ms ease !important;
    }
  }
</style>
