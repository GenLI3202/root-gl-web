---
import type { Locale } from "@/i18n";
import { AGENT_SKILLS } from "@/data/skills";

interface Props {
  locale: Locale;
}

interface SkillsCopy {
  title: string;
  note: string;
  intro: string;
  trySaying: string;
  parts: string;
  planned: string;
  install: string;
  installGuide: string;
  copy: string;
  copied: string;
  repo: string;
}

const { locale } = Astro.props;

const COPY: Record<Locale, SkillsCopy> = {
  en: {
    title: "Skills for AI agents",
    note: "how I want recurring work done",
    intro:
      "Reusable SKILL.md workflows I wrote for Claude Code and similar agents. Each one turns a job I keep repeating into a fixed process, with gates where a human decides.",
    trySaying: "Try saying",
    parts: "Inside",
    planned: "planned",
    install: "Install",
    installGuide: "Install guide ↗",
    copy: "Copy",
    copied: "Copied",
    repo: "GitHub ↗",
  },
  zh: {
    title: "给 AI 智能体写的技能",
    note: "把反复要做的事写成流程",
    intro:
      "我为 Claude Code 等智能体写的可复用 SKILL.md 工作流。每个都把一件反复要做的事固定成流程，并在关键处留给人来决定。",
    trySaying: "可以这样说",
    parts: "包含",
    planned: "计划中",
    install: "安装",
    installGuide: "安装说明 ↗",
    copy: "复制",
    copied: "已复制",
    repo: "GitHub ↗",
  },
  de: {
    title: "Skills für KI-Agenten",
    note: "wie wiederkehrende Arbeit laufen soll",
    intro:
      "Wiederverwendbare SKILL.md-Workflows, die ich für Claude Code und ähnliche Agenten geschrieben habe. Jeder macht aus einer Aufgabe, die ich immer wieder erledige, einen festen Ablauf mit Haltepunkten, an denen ein Mensch entscheidet.",
    trySaying: "Zum Beispiel",
    parts: "Enthält",
    planned: "geplant",
    install: "Installieren",
    installGuide: "Installationsanleitung ↗",
    copy: "Kopieren",
    copied: "Kopiert",
    repo: "GitHub ↗",
  },
};

const copy = COPY[locale];
---

<section class="skills" aria-labelledby="skills-title">
  <div class="skills-head">
    <h2 class="skills-title" id="skills-title">{copy.title}</h2>
    <span class="skills-note hand">{copy.note}</span>
  </div>
  <p class="skills-intro">{copy.intro}</p>

  <ul class="skill-list" role="list">
    {AGENT_SKILLS.map((skill) => (
      <li class="skill">
        <div class="skill-tab" aria-hidden="true">SKILL.md</div>
        <div class="skill-body">
          <h3 class="skill-name">{skill.id}</h3>
          <p class="skill-summary">{skill.summary[locale]}</p>

          <div class="skill-triggers">
            <span class="skill-label">{copy.trySaying}</span>
            {skill.triggers.map((t) => <span class="trigger hand">“{t}”</span>)}
          </div>

          {skill.parts && (
            <div class="skill-parts">
              <span class="skill-label">{copy.parts}</span>
              <ul role="list">
                {skill.parts.map((part) => (
                  <li class:list={["part", { planned: part.status === "planned" }]}>
                    <code>{part.name}</code>
                    <span class="part-role">
                      {part.role[locale]}
                      {part.status === "planned" && ` · ${copy.planned}`}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="skill-foot">
            {skill.install && (
              <div class="install">
                <span class="skill-label">{copy.install}</span>
                <div class="install-row">
                  <code class="install-cmd">{skill.install}</code>
                  <button
                    type="button"
                    class="copy-btn"
                    data-copy={skill.install}
                    data-copied-label={copy.copied}
                  >
                    {copy.copy}
                  </button>
                </div>
              </div>
            )}
            <div class="skill-links">
              {skill.installGuide && (
                <a href={skill.installGuide} target="_blank" rel="noopener noreferrer">{copy.installGuide}</a>
              )}
              <a href={skill.repo} target="_blank" rel="noopener noreferrer">{copy.repo}</a>
            </div>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

<script>
  function initCopyButtons(): void {
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      const label = btn.textContent ?? "";
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? "");
          btn.textContent = btn.dataset.copiedLabel ?? label;
          window.setTimeout(() => (btn.textContent = label), 1600);
        } catch {
          // Clipboard can be blocked; the command stays visible for manual copying
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initCopyButtons);
</script>

<style>
  .skills-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .skills-title {
    font-size: var(--text-2xl);
  }

  .skills-note {
    font-size: 1.2rem;
    color: var(--fg-muted);
  }

  .skills-intro {
    max-width: 44rem;
    color: var(--fg-muted);
    margin: 0.5rem 0 1.5rem;
  }

  .skill-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .skill {
    position: relative;
    padding-top: 1.6rem;
  }

  /* Folder-style tab sitting on the card, like a file on a desk */
  .skill-tab {
    position: absolute;
    top: 0;
    left: 1.25rem;
    padding: 0.2rem 0.8rem 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--fg);
    background: var(--surface);
    border: 1.5px solid var(--border-dark);
    border-bottom: none;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  }

  .skill-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.25rem 1.4rem 1.3rem;
    background: var(--surface);
    border: 1.5px solid var(--border-dark);
    border-radius: 0 var(--radius-lg) var(--radius-lg) var(--radius-lg);
    transition: border-color var(--transition), box-shadow 300ms var(--ease-out);
  }

  .skill:hover .skill-body,
  .skill:hover .skill-tab {
    border-color: var(--fg);
  }

  .skill:hover .skill-body {
    box-shadow: var(--shadow-hover);
  }

  .skill-name {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
    word-break: break-word;
  }

  .skill-summary {
    font-size: var(--text-base);
    line-height: 1.65;
    max-width: 52rem;
  }

  .skill-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .skill-triggers {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
  }

  .trigger {
    font-size: 1.2rem;
  }

  .skill-parts {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .skill-parts ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .part {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-pill);
    background: var(--bg);
    font-size: var(--text-xs);
  }

  .part code {
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .part-role {
    color: var(--fg-muted);
  }

  .part.planned {
    border-style: dashed;
    opacity: 0.75;
  }

  .skill-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--border-dark);
  }

  .install {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    flex: 1 1 24rem;
  }

  .install-row {
    display: flex;
    align-items: stretch;
    min-width: 0;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-sm);
    background: var(--bg);
    overflow: hidden;
  }

  .install-cmd {
    flex: 1;
    min-width: 0;
    padding: 0.45rem 0.7rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
    overflow-x: auto;
  }

  .copy-btn {
    flex-shrink: 0;
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0 0.85rem;
    border: none;
    border-left: 1px solid var(--border-dark);
    background: var(--surface);
    color: var(--fg);
    cursor: pointer;
    transition: background var(--transition), color var(--transition);
  }

  .copy-btn:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .skill-links {
    display: flex;
    gap: 1rem;
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
