---
import type { Locale } from "@/i18n";

/**
 * Live line under the homepage intro: Munich time, current weather, and what to wear for it.
 * The advice follows the felt temperature, with a note for rain, snow, storms or strong sun.
 * Weather comes from Open-Meteo (no API key); without it the line shows the time only.
 */
interface Props {
  locale: Locale;
}

interface ClockCopy {
  fallback: string;
  timeLine: string;
  wearLabel: string;
  conditions: Record<string, string>;
  /** Outfits from coldest to warmest, matching WEAR_BANDS in the script */
  wear: string[];
  extras: Record<string, string>;
}

const { locale } = Astro.props;

/* Placeholders in timeLine: {time}, {weather}. */
const COPY: Record<Locale, ClockCopy> = {
  en: {
    fallback: "Written from Munich, Germany.",
    timeLine: "It's {time} in Munich{weather}.",
    wearLabel: "What to wear:",
    conditions: {
      clear: "clear skies",
      cloudy: "cloudy",
      fog: "foggy",
      drizzle: "drizzling",
      rain: "raining",
      snow: "snowing",
      storm: "stormy",
    },
    wear: [
      "a down coat, hat, scarf and gloves.",
      "a winter coat, scarf and gloves.",
      "a warm coat and a scarf.",
      "a jacket or a thick jumper.",
      "a light jacket or a long-sleeve top.",
      "a T-shirt, with a thin layer for later.",
      "shorts and a T-shirt.",
    ],
    extras: {
      rain: "Take an umbrella.",
      snow: "Wear shoes with grip.",
      storm: "Best to stay indoors for now.",
      sun: "Sunglasses and sunscreen help.",
    },
  },
  zh: {
    fallback: "写于德国慕尼黑。",
    timeLine: "慕尼黑现在 {time}{weather}。",
    wearLabel: "穿衣建议：",
    conditions: {
      clear: "晴",
      cloudy: "多云",
      fog: "有雾",
      drizzle: "飘着小雨",
      rain: "下着雨",
      snow: "下着雪",
      storm: "打着雷",
    },
    wear: [
      "羽绒服，戴好帽子、围巾和手套。",
      "冬季大衣，加围巾和手套。",
      "保暖外套，配一条围巾。",
      "夹克或厚毛衣。",
      "薄外套或长袖。",
      "短袖，备一件薄外套。",
      "短袖短裤。",
    ],
    extras: {
      rain: "记得带伞。",
      snow: "穿防滑的鞋。",
      storm: "这会儿最好待在室内。",
      sun: "戴上墨镜，涂点防晒。",
    },
  },
  de: {
    fallback: "Geschrieben in München.",
    timeLine: "In München ist es {time}{weather}.",
    wearLabel: "Kleidungstipp:",
    conditions: {
      clear: "klar",
      cloudy: "bewölkt",
      fog: "neblig",
      drizzle: "Nieselregen",
      rain: "Regen",
      snow: "Schnee",
      storm: "Gewitter",
    },
    wear: [
      "Daunenjacke, Mütze, Schal und Handschuhe.",
      "Wintermantel, Schal und Handschuhe.",
      "ein warmer Mantel und ein Schal.",
      "eine Jacke oder ein dicker Pullover.",
      "eine leichte Jacke oder ein Langarmshirt.",
      "T-Shirt, dazu eine dünne Schicht für später.",
      "kurze Hose und T-Shirt.",
    ],
    extras: {
      rain: "Schirm nicht vergessen.",
      snow: "Schuhe mit gutem Profil.",
      storm: "Am besten erst mal drinnen bleiben.",
      sun: "Sonnenbrille und Sonnencreme.",
    },
  },
};

const copy = COPY[locale];
---

<div class="munich-clock" data-munich-clock data-locale={locale} data-copy={JSON.stringify(copy)}>
  <span class="clock-dot" aria-hidden="true"></span>
  <p class="clock-text" aria-live="polite">{copy.fallback}</p>
</div>

<script>
  interface ClockCopy {
    fallback: string;
    timeLine: string;
    wearLabel: string;
    conditions: Record<string, string>;
    wear: string[];
    extras: Record<string, string>;
  }

  interface Weather {
    temp: number;
    feelsLike: number;
    condition: string;
  }

  const DATE_LOCALES: Record<string, string> = { en: "en-GB", zh: "zh-CN", de: "de-DE" };
  const WEATHER_URL =
    "https://api.open-meteo.com/v1/forecast?latitude=48.14&longitude=11.58" +
    "&current=temperature_2m,apparent_temperature,weather_code&timezone=Europe%2FBerlin";
  const WEATHER_CACHE_KEY = "munich-weather-v2";
  const WEATHER_TTL_MS = 30 * 60 * 1000;
  /** Upper felt-temperature limits (°C) of each outfit in ClockCopy.wear; the last is open */
  const WEAR_BANDS = [-5, 2, 8, 14, 19, 24];
  /** Sun advice applies on clear days this warm, between these Munich hours */
  const SUN_MIN_C = 20;
  const SUN_HOURS = [10, 17];

  let clockTimer: number | undefined;
  let weather: Weather | null = null;

  /** Map a WMO weather code to one of the condition keys in ClockCopy */
  function conditionFromCode(code: number): string {
    if (code === 0 || code === 1) return "clear";
    if (code === 2 || code === 3) return "cloudy";
    if (code === 45 || code === 48) return "fog";
    if (code >= 51 && code <= 57) return "drizzle";
    if ((code >= 61 && code <= 67) || (code >= 80 && code <= 82)) return "rain";
    if ((code >= 71 && code <= 77) || code === 85 || code === 86) return "snow";
    if (code >= 95) return "storm";
    return "cloudy";
  }

  function wearFor(copy: ClockCopy, feelsLike: number): string {
    const band = WEAR_BANDS.findIndex((limit) => feelsLike < limit);
    return copy.wear[band === -1 ? copy.wear.length - 1 : band];
  }

  /** One extra note for the weather, or null */
  function extraFor(copy: ClockCopy, w: Weather, hour: number): string | null {
    if (w.condition === "drizzle" || w.condition === "rain") return copy.extras.rain;
    if (w.condition === "snow" || w.condition === "storm") return copy.extras[w.condition];
    const sunny = w.condition === "clear" && w.temp >= SUN_MIN_C;
    if (sunny && hour >= SUN_HOURS[0] && hour < SUN_HOURS[1]) return copy.extras.sun;
    return null;
  }

  function fill(template: string, values: Record<string, string>): string {
    return template.replace(/\{(\w+)\}/g, (_, key: string) => values[key] ?? "");
  }

  function munichNow(locale: string): { hour: number; time: string } {
    const now = new Date();
    const hour = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Europe/Berlin",
      hour: "2-digit",
      hour12: false,
    }).format(now);
    return {
      hour: Number(hour) % 24,
      time: new Intl.DateTimeFormat(DATE_LOCALES[locale], {
        timeZone: "Europe/Berlin",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      }).format(now),
    };
  }

  function renderClock(el: HTMLElement): void {
    const locale = el.dataset.locale ?? "en";
    const copy = JSON.parse(el.dataset.copy ?? "{}") as ClockCopy;
    const text = el.querySelector<HTMLElement>(".clock-text");
    if (!text) return;

    const { hour, time } = munichNow(locale);
    const sep = locale === "zh" ? "" : " ";
    const comma = locale === "zh" ? "，" : ", ";

    const weatherPart = weather
      ? `${comma}${Math.round(weather.temp)}${locale === "de" ? " °C" : "°C"}` +
        `${comma}${copy.conditions[weather.condition]}`
      : "";

    text.replaceChildren();
    const timeLine = fill(copy.timeLine, { time: "\u0000", weather: weatherPart });
    const [before, after] = timeLine.split("\u0000");
    const strong = document.createElement("strong");
    strong.textContent = time;
    text.append(before, strong, after);

    if (weather) {
      const advice = [`${copy.wearLabel}${sep}${wearFor(copy, weather.feelsLike)}`];
      const extra = extraFor(copy, weather, hour);
      if (extra) advice.push(extra);
      text.append(sep, advice.join(sep));
    }
    el.classList.add("is-live");
  }

  function readCachedWeather(): Weather | null {
    try {
      const raw = sessionStorage.getItem(WEATHER_CACHE_KEY);
      if (!raw) return null;
      const cached = JSON.parse(raw) as Weather & { at: number };
      return Date.now() - cached.at < WEATHER_TTL_MS ? cached : null;
    } catch {
      return null;
    }
  }

  async function fetchWeather(): Promise<Weather | null> {
    const cached = readCachedWeather();
    if (cached) return cached;
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 4000);
    try {
      const res = await fetch(WEATHER_URL, { signal: controller.signal });
      if (!res.ok) return null;
      const data = (await res.json()) as {
        current?: { temperature_2m?: number; apparent_temperature?: number; weather_code?: number };
      };
      const temp = data.current?.temperature_2m;
      const code = data.current?.weather_code;
      if (typeof temp !== "number" || typeof code !== "number") return null;
      const feels = data.current?.apparent_temperature;
      const result: Weather = {
        temp,
        feelsLike: typeof feels === "number" ? feels : temp,
        condition: conditionFromCode(code),
      };
      try {
        sessionStorage.setItem(WEATHER_CACHE_KEY, JSON.stringify({ ...result, at: Date.now() }));
      } catch {
        // Storage can be unavailable (private mode); the fetched value still works
      }
      return result;
    } catch {
      return null;
    } finally {
      window.clearTimeout(timeout);
    }
  }

  function initClock(): void {
    window.clearInterval(clockTimer);
    const el = document.querySelector<HTMLElement>("[data-munich-clock]");
    if (!el) return;
    renderClock(el);
    clockTimer = window.setInterval(() => renderClock(el), 30_000);
    fetchWeather().then((w) => {
      if (!w || !el.isConnected) return;
      weather = w;
      renderClock(el);
    });
  }

  document.addEventListener("astro:page-load", initClock);
</script>

<style>
  .munich-clock {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
    margin-bottom: 1.75rem;
    max-width: 38rem;
  }

  .clock-text {
    color: inherit;
    line-height: 1.6;
  }

  .clock-text :global(strong) {
    color: var(--fg);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .clock-dot {
    position: relative;
    top: -0.05rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--border-dark);
    flex-shrink: 0;
  }

  .munich-clock.is-live .clock-dot {
    background: var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 var(--accent-soft); }
    50% { box-shadow: 0 0 0 0.35rem var(--accent-soft); }
  }
</style>
