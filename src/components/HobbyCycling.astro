---
import HobbyShell from "@/components/HobbyShell.astro";
import HandIcon from "@/components/HandIcon.astro";
import CyclingYearLines from "@/components/CyclingYearLines.astro";
import CyclingCalendar from "@/components/CyclingCalendar.astro";
import CyclingRideMix from "@/components/CyclingRideMix.astro";
import CyclingKey from "@/components/CyclingKey.astro";
import { t, type Locale } from "@/i18n";
import {
  formatDate,
  formatNumber,
  loadCycling,
  ridesText,
  totalsThrough,
} from "@/utils/cycling";

interface Props {
  locale: Locale;
}

interface CyclingCopy {
  kicker: string;
  numbers: string;
  findMe: string;
  stravaNote: string;
  clubNote: string;
  clubName: string;
  soFar: (year: number) => string;
  through: (date: string) => string;
  tiles: { distance: string; climbing: string; rides: string; time: string };
  vsSame: (year: number) => string;
  since: (date: string) => string;
  synced: string;
  empty: string;
  trainingTitle: string;
  yoyTitle: string;
  yoyCaption: string;
  yoyHint: string;
  calendarTitle: string;
  calendarCaption: string;
  noRide: string;
  keyTitle: string;
  mixTitle: string;
  mixCaption: string;
  tableSummary: string;
  columns: string[];
}

const { locale } = Astro.props;

const COPY: Record<Locale, CyclingCopy> = {
  en: {
    kicker: "Isar mornings, weekends south of Munich",
    numbers: "By the numbers",
    findMe: "Where to find me",
    stravaNote: "Every ride, logged.",
    clubNote: "Group rides, routes, and the club site I help build.",
    clubName: "Across Cycling Club",
    soFar: (year) => `${year} so far`,
    through: (date) => `through ${date}`,
    tiles: { distance: "Distance", climbing: "Climbing", rides: "Rides", time: "Time in the saddle" },
    vsSame: (year) => `vs. same date in ${year}`,
    since: (date) => `Since ${date}`,
    synced: "Synced from Strava once a day.",
    empty: "The numbers appear after the first Strava sync.",
    trainingTitle: "Training, year by year",
    yoyTitle: "Distance, year over year",
    yoyCaption: "Running total from 1 January. Hover or use the arrow keys to compare any date.",
    yoyHint: "Use the left and right arrow keys to compare dates",
    calendarTitle: "Riding days",
    calendarCaption: "One square per day. A darker square is a longer day.",
    noRide: "no ride",
    keyTitle: "Length",
    mixTitle: "How long the rides are",
    mixCaption: "Rides per year, grouped by distance.",
    tableSummary: "All numbers as a table",
    columns: ["Year", "Rides", "Ride days", "Distance km", "Climbing m", "Hours", "Longest km", "100+ km rides", "Avg km/h"],
  },
  zh: {
    kicker: "伊萨尔河的清晨，慕尼黑以南的周末",
    numbers: "数字",
    findMe: "在哪找到我",
    stravaNote: "每一次骑行的记录。",
    clubNote: "团骑、路线，还有我参与建设的俱乐部网站。",
    clubName: "Across 骑行俱乐部",
    soFar: (year) => `${year} 年至今`,
    through: (date) => `截至 ${date}`,
    tiles: { distance: "距离", climbing: "爬升", rides: "骑行次数", time: "骑行时间" },
    vsSame: (year) => `较 ${year} 年同期`,
    since: (date) => `自 ${date}起`,
    synced: "数据每天从 Strava 自动同步。",
    empty: "首次同步 Strava 之后，这里会显示数据。",
    trainingTitle: "训练：逐年对比",
    yoyTitle: "累计里程，逐年对比",
    yoyCaption: "自 1 月 1 日起的累计距离。悬停或用方向键对比任意日期。",
    yoyHint: "用左右方向键对比日期",
    calendarTitle: "骑行日历",
    calendarCaption: "每天一格，颜色越深，当天骑得越远。",
    noRide: "未骑行",
    keyTitle: "距离",
    mixTitle: "骑行距离分布",
    mixCaption: "每年的骑行次数，按单次距离分组。",
    tableSummary: "查看全部数字",
    columns: ["年份", "次数", "骑行天数", "距离 km", "爬升 m", "时长 h", "最长 km", "百公里以上", "均速 km/h"],
  },
  de: {
    kicker: "Isar-Morgen, Wochenenden südlich von München",
    numbers: "In Zahlen",
    findMe: "Wo du mich findest",
    stravaNote: "Jede Ausfahrt, protokolliert.",
    clubNote: "Gruppenausfahrten, Routen und die Club-Website, an der ich mitbaue.",
    clubName: "Across Cycling Club",
    soFar: (year) => `${year} bisher`,
    through: (date) => `bis ${date}`,
    tiles: { distance: "Distanz", climbing: "Höhenmeter", rides: "Ausfahrten", time: "Zeit im Sattel" },
    vsSame: (year) => `ggü. gleichem Datum ${year}`,
    since: (date) => `Seit ${date}`,
    synced: "Einmal täglich von Strava synchronisiert.",
    empty: "Die Zahlen erscheinen nach dem ersten Strava-Sync.",
    trainingTitle: "Training, Jahr für Jahr",
    yoyTitle: "Distanz im Jahresvergleich",
    yoyCaption: "Laufende Summe seit 1. Januar. Mit der Maus oder den Pfeiltasten jedes Datum vergleichen.",
    yoyHint: "Mit den Pfeiltasten links und rechts Daten vergleichen",
    calendarTitle: "Fahrtage",
    calendarCaption: "Ein Feld pro Tag. Je dunkler, desto länger der Tag.",
    noRide: "keine Fahrt",
    keyTitle: "Länge",
    mixTitle: "Wie lang die Ausfahrten sind",
    mixCaption: "Ausfahrten pro Jahr, nach Distanz gruppiert.",
    tableSummary: "Alle Zahlen als Tabelle",
    columns: ["Jahr", "Ausfahrten", "Fahrtage", "Distanz km", "Höhenmeter m", "Stunden", "Längste km", "100+ km", "Ø km/h"],
  },
};

const copy = COPY[locale];
const data = loadCycling();

// Year to date against the same calendar date a year earlier
const current = data?.years.find((y) => y.year === data.year);
const previous = data ? totalsThrough(data.rides, data.year - 1, data.asOf.slice(5)) : null;
const hours = (seconds: number): number => Math.round(seconds / 3600);

function delta(now: number, before: number, unit: string): string {
  const diff = Math.round(now - before);
  const sign = diff > 0 ? "+" : diff < 0 ? "−" : "±";
  return `${sign}${formatNumber(locale, Math.abs(diff))}${unit} ${copy.vsSame(data!.year - 1)}`;
}

const tiles =
  data && current && previous
    ? [
        { label: copy.tiles.distance, value: formatNumber(locale, current.km), unit: "km",
          note: previous.rides ? delta(current.km, previous.km, " km") : "" },
        { label: copy.tiles.climbing, value: formatNumber(locale, current.m), unit: "m",
          note: previous.rides ? delta(current.m, previous.m, " m") : "" },
        { label: copy.tiles.rides, value: formatNumber(locale, current.rides), unit: "",
          note: previous.rides ? delta(current.rides, previous.rides, "") : "" },
        { label: copy.tiles.time, value: formatNumber(locale, hours(current.s)), unit: "h",
          note: previous.rides ? delta(hours(current.s), hours(previous.s), " h") : "" },
      ]
    : [];

const asOfDate = data ? new Date(`${data.asOf}T00:00:00Z`) : null;
const firstDate = data ? new Date(`${data.first}T00:00:00Z`) : null;
const sinceText =
  data && firstDate
    ? copy.since(formatDate(locale, firstDate, { month: "short", year: "numeric" }))
    : "";

const tableRows = data
  ? [...data.years].reverse().map((y) => [
      String(y.year),
      formatNumber(locale, y.rides),
      formatNumber(locale, y.days),
      formatNumber(locale, y.km),
      formatNumber(locale, y.m),
      formatNumber(locale, hours(y.s)),
      formatNumber(locale, y.longest, 1),
      formatNumber(locale, y.centuries),
      formatNumber(locale, y.avgSpeed, 1),
    ])
  : [];
---

<HobbyShell
  locale={locale}
  hobby="cycling"
  kicker={copy.kicker}
  lead={t(locale, "hobbies.cycling.lead")}
  illustration="/images/hobbies/cyclist-rider.svg"
>
  <section class="hobby-section">
    <h2 class="section-title">
      {data ? copy.soFar(data.year) : copy.numbers}
      {asOfDate && (
        <span class="section-sub">
          {copy.through(formatDate(locale, asOfDate, { day: "numeric", month: "short" }))}
        </span>
      )}
    </h2>
    {data ? (
      <>
        <ul class="stats" role="list">
          {tiles.map((tile) => (
            <li class="stat">
              <span class="stat-num">
                {tile.value}
                {tile.unit && <span class="stat-unit"> {tile.unit}</span>}
              </span>
              <span class="stat-label">{tile.label}</span>
              {tile.note && <span class="stat-delta">{tile.note}</span>}
            </li>
          ))}
        </ul>
        <p class="stat-note">
          {sinceText}: {formatNumber(locale, data.all.km)} km · {formatNumber(locale, data.all.m)} m ·
          {" "}{ridesText(locale, data.all.rides)}. {copy.synced}
        </p>
      </>
    ) : (
      <p class="stat-note">{copy.empty}</p>
    )}
  </section>

  {data && (
    <section class="hobby-section">
      <h2 class="section-title">{copy.trainingTitle}</h2>

      <div class="cycling-charts" data-chart-locale={locale}>
        <article class="chart-card">
          <h3 class="chart-title">{copy.yoyTitle}</h3>
          <p class="chart-caption">{copy.yoyCaption}</p>
          <CyclingYearLines data={data} locale={locale} title={copy.yoyTitle} hint={copy.yoyHint} />
        </article>

        <article class="chart-card">
          <h3 class="chart-title">{copy.calendarTitle}</h3>
          <p class="chart-caption">{copy.calendarCaption}</p>
          <CyclingKey title={copy.keyTitle} empty={copy.noRide} />
          <CyclingCalendar data={data} locale={locale} title={copy.calendarTitle} />
        </article>

        <article class="chart-card">
          <h3 class="chart-title">{copy.mixTitle}</h3>
          <p class="chart-caption">{copy.mixCaption}</p>
          <CyclingKey title={copy.keyTitle} />
          <CyclingRideMix data={data} locale={locale} title={copy.mixTitle} />
        </article>

        <div class="chart-tip" role="tooltip" hidden></div>
      </div>

      <details class="table-view">
        <summary>{copy.tableSummary}</summary>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                {copy.columns.map((c, i) => <th scope="col" class:list={{ num: i > 0 }}>{c}</th>)}
              </tr>
            </thead>
            <tbody>
              {tableRows.map((row) => (
                <tr>
                  {row.map((cell, i) =>
                    i === 0 ? <th scope="row">{cell}</th> : <td class="num">{cell}</td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </section>
  )}

  <section class="hobby-section">
    <h2 class="section-title">{copy.findMe}</h2>
    <ul class="links" role="list">
      <li>
        <a class="link-card" href="https://www.strava.com/athletes/119635546" target="_blank" rel="noopener noreferrer">
          <HandIcon name="route" size={28} />
          <span class="link-text">
            <span class="link-title">Strava ↗</span>
            <span class="link-note">{copy.stravaNote}</span>
          </span>
        </a>
      </li>
      <li>
        <a class="link-card" href="https://www.across-cc.de/" target="_blank" rel="noopener noreferrer">
          <HandIcon name="bike" size={28} />
          <span class="link-text">
            <span class="link-title">{copy.clubName} ↗</span>
            <span class="link-note">{copy.clubNote}</span>
          </span>
        </a>
      </li>
    </ul>
  </section>
</HobbyShell>

<style>
  .hobby-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-title {
    font-size: var(--text-2xl);
  }

  .section-sub {
    margin-left: 0.6rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--fg-muted);
  }

  .stats {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem;
    border: 1.5px solid var(--border-dark);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .stat-num {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--accent);
    line-height: 1.1;
  }

  .stat-unit {
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--fg-muted);
  }

  .stat-label {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .stat-delta {
    margin-top: 0.35rem;
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .stat-note {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--fg-muted);
  }

  /* ── Charts ── */
  .cycling-charts {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .chart-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem;
    border: 1.5px solid var(--border-dark);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .chart-title {
    font-size: var(--text-lg);
  }

  .chart-caption {
    margin-bottom: 0.5rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .chart-tip {
    position: fixed;
    z-index: 60;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-md);
    background: var(--bg);
    box-shadow: var(--shadow-hover);
    font-size: var(--text-sm);
    pointer-events: none;
  }

  .chart-tip[hidden] {
    display: none;
  }

  .chart-tip :global(.tip-title) {
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .chart-tip :global(.tip-row) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .chart-tip :global(.tip-key) {
    width: 14px;
    height: 2px;
    border-radius: 1px;
  }

  .chart-tip :global(.tip-label) {
    color: var(--fg-muted);
  }

  /* ── Table view ── */
  .table-view summary {
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .table-view summary:hover {
    color: var(--accent);
  }

  .table-scroll {
    margin-top: 0.75rem;
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  th,
  td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    white-space: nowrap;
  }

  thead th {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--fg-muted);
    border-bottom-color: var(--border-dark);
  }

  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* ── Links ── */
  .links {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .link-card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    height: 100%;
    padding: 1.1rem 1.25rem;
    border: 1.5px solid var(--border-dark);
    border-radius: var(--radius-md);
    color: var(--fg);
    text-decoration: none;
    transition: border-color var(--transition), transform 250ms var(--ease-out);
  }

  .link-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .link-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .link-title {
    font-weight: 600;
  }

  .link-note {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  @media (max-width: 560px) {
    .stat {
      padding: 1rem;
    }

    .stat-num {
      font-size: var(--text-2xl);
    }

    .chart-card {
      padding: 1rem;
    }
  }
</style>

<script>
  interface TipRow {
    value: string;
    label: string;
    key?: { color: string; opacity: number };
  }

  interface YearSeries {
    year: number;
    current: boolean;
    opacity: number;
    values: (number | null)[];
  }

  const LAST_INDEX = 365;
  const WEEK = 7;
  const seriesCache = new WeakMap<Element, YearSeries[]>();
  let bound = false;

  function tipElement(): HTMLElement | null {
    return document.querySelector<HTMLElement>(".chart-tip");
  }

  function showTip(title: string, rows: TipRow[], clientX: number, clientY: number): void {
    const tip = tipElement();
    if (!tip) return;
    const head = document.createElement("div");
    head.className = "tip-title";
    head.textContent = title;
    const items = rows.map((row) => {
      const el = document.createElement("div");
      el.className = "tip-row";
      if (row.key) {
        const key = document.createElement("span");
        key.className = "tip-key";
        key.style.background = row.key.color;
        key.style.opacity = String(row.key.opacity);
        el.append(key);
      }
      const value = document.createElement("strong");
      value.textContent = row.value;
      const label = document.createElement("span");
      label.className = "tip-label";
      label.textContent = row.label;
      el.append(value, label);
      return el;
    });
    tip.replaceChildren(head, ...items);
    tip.hidden = false;

    const pad = 12;
    const { offsetWidth: w, offsetHeight: h } = tip;
    let x = clientX + pad;
    if (x + w > window.innerWidth - 8) x = clientX - w - pad;
    let y = clientY - h - pad;
    if (y < 8) y = clientY + pad;
    tip.style.left = `${Math.max(8, x)}px`;
    tip.style.top = `${y}px`;
  }

  function hideTip(): void {
    const tip = tipElement();
    if (tip) tip.hidden = true;
  }

  /** Tooltip for a calendar cell or length segment: data-tip holds "value|label" */
  function showMark(mark: Element, clientX: number, clientY: number): void {
    const el = mark as HTMLElement;
    const rows = (el.dataset.tip ?? "").split(";;").map((row) => {
      const [value, label = ""] = row.split("|");
      return { value, label };
    });
    showTip(el.dataset.tipTitle ?? "", rows, clientX, clientY);
  }

  function yearSeries(root: Element): YearSeries[] {
    let series = seriesCache.get(root);
    if (!series) {
      series = JSON.parse(root.querySelector(".yoy-data")?.textContent ?? "[]") as YearSeries[];
      seriesCache.set(root, series);
    }
    return series;
  }

  function hideCrosshair(svg: SVGSVGElement): void {
    svg.querySelectorAll<SVGElement>(".cross, .dot").forEach((el) => {
      el.style.visibility = "hidden";
    });
  }

  /** Move the crosshair of a year-over-year plot to a day of the year and show every year there */
  function showCrosshair(hit: SVGRectElement, index: number): void {
    const svg = hit.ownerSVGElement;
    const root = svg?.closest<HTMLElement>(".yoy");
    if (!svg || !root) return;
    const day = Math.min(Math.max(index, 0), LAST_INDEX);
    hit.dataset.index = String(day);

    const ml = Number(svg.dataset.ml);
    const pw = Number(svg.dataset.pw);
    const mt = Number(svg.dataset.mt);
    const ph = Number(svg.dataset.ph);
    const yEnd = Number(svg.dataset.yend);
    const x = ml + (day / LAST_INDEX) * pw;

    const cross = svg.querySelector<SVGLineElement>(".cross");
    if (cross) {
      cross.setAttribute("x1", String(x));
      cross.setAttribute("x2", String(x));
      cross.style.visibility = "visible";
    }

    const locale = root.dataset.locale ?? "en";
    const numbers = new Intl.NumberFormat(locale);
    const rows: TipRow[] = [];
    for (const s of yearSeries(root)) {
      const dot = svg.querySelector<SVGCircleElement>(`.dot[data-year="${s.year}"]`);
      const km = s.values[day];
      if (km === null || km === undefined) {
        if (dot) dot.style.visibility = "hidden";
        continue;
      }
      if (dot) {
        dot.setAttribute("cx", String(x));
        dot.setAttribute("cy", String(mt + ph - (km / yEnd) * ph));
        dot.style.opacity = String(s.opacity);
        dot.style.visibility = "visible";
      }
      rows.push({
        key: { color: s.current ? "var(--accent)" : "var(--fg-muted)", opacity: s.opacity },
        value: `${numbers.format(km)} ${root.dataset.unit ?? ""}`,
        label: String(s.year),
      });
    }

    const refYear = Number(root.dataset.refYear);
    const title = new Intl.DateTimeFormat(locale, {
      day: "numeric",
      month: "long",
      timeZone: "UTC",
    }).format(new Date(Date.UTC(refYear, 0, 1 + day)));

    const box = svg.getBoundingClientRect();
    const scale = box.width / svg.viewBox.baseVal.width;
    showTip(title, rows, box.left + x * scale, box.top + (mt + ph / 3) * scale);
  }

  function indexAtPointer(hit: SVGRectElement, clientX: number): number {
    const svg = hit.ownerSVGElement as SVGSVGElement;
    const box = svg.getBoundingClientRect();
    const scale = svg.viewBox.baseVal.width / box.width;
    const ml = Number(svg.dataset.ml);
    const pw = Number(svg.dataset.pw);
    return Math.round((((clientX - box.left) * scale - ml) / pw) * LAST_INDEX);
  }

  function lastDayOfCurrentYear(hit: SVGRectElement): number {
    const root = hit.ownerSVGElement?.closest(".yoy");
    const current = root ? yearSeries(root).find((s) => s.current) : undefined;
    return current ? current.values.length - 1 : LAST_INDEX;
  }

  function initCharts(): void {
    if (bound) return;
    bound = true;

    document.addEventListener("pointermove", (event) => {
      const target = event.target as Element | null;
      const hit = target?.closest<SVGRectElement>(".yoy .hit");
      if (hit) {
        showCrosshair(hit, indexAtPointer(hit, event.clientX));
        return;
      }
      const mark = target?.closest("[data-tip]");
      if (mark && mark.closest(".cycling-charts")) {
        showMark(mark, event.clientX, event.clientY);
        return;
      }
      if (target?.closest(".cycling-charts")) {
        hideTip();
        document.querySelectorAll<SVGSVGElement>(".yoy svg").forEach(hideCrosshair);
      }
    });

    document.addEventListener("pointerleave", () => hideTip());
    document.addEventListener("pointerout", (event) => {
      const target = event.target as Element | null;
      const related = event.relatedTarget as Element | null;
      if (!target?.closest(".cycling-charts") || related?.closest(".cycling-charts")) return;
      hideTip();
      document.querySelectorAll<SVGSVGElement>(".yoy svg").forEach(hideCrosshair);
    });

    document.addEventListener("focusin", (event) => {
      const target = event.target as Element | null;
      const hit = target?.closest<SVGRectElement>(".yoy .hit");
      if (hit) {
        showCrosshair(hit, Number(hit.dataset.index ?? lastDayOfCurrentYear(hit)));
        return;
      }
      const mark = target?.closest("[data-tip]");
      if (mark && mark.closest(".cycling-charts")) {
        const box = mark.getBoundingClientRect();
        showMark(mark, box.left + box.width / 2, box.top);
      }
    });

    document.addEventListener("focusout", (event) => {
      const target = event.target as Element | null;
      if (!target?.closest(".cycling-charts")) return;
      hideTip();
      document.querySelectorAll<SVGSVGElement>(".yoy svg").forEach(hideCrosshair);
    });

    document.addEventListener("keydown", (event) => {
      const hit = (event.target as Element | null)?.closest<SVGRectElement>(".yoy .hit");
      if (!hit || (event.key !== "ArrowLeft" && event.key !== "ArrowRight")) return;
      event.preventDefault();
      const step = event.key === "ArrowRight" ? WEEK : -WEEK;
      showCrosshair(hit, Number(hit.dataset.index ?? lastDayOfCurrentYear(hit)) + step);
    });
  }

  /** The calendar scrolls sideways on a phone; open it on the most recent weeks */
  function scrollCalendarsToLatest(): void {
    document.querySelectorAll<HTMLElement>(".cycling-charts .scroll").forEach((el) => {
      el.scrollLeft = el.scrollWidth;
    });
  }

  document.addEventListener("astro:page-load", () => {
    initCharts();
    scrollCalendarsToLatest();
  });
</script>
