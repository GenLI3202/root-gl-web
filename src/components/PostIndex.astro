---
import type { Locale } from "@/i18n";
import {
  formatPostDate,
  getPostLabels,
  getPostUrl,
  type PostEntry,
} from "@/utils/posts";

interface Props {
  locale: Locale;
  posts: PostEntry[];
}

const { locale, posts } = Astro.props;
const labels = getPostLabels(locale);

const postsByYear: Record<number, PostEntry[]> = {};
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!postsByYear[year]) postsByYear[year] = [];
  postsByYear[year].push(post);
}

const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<div class="container posts-page">
  <h1 class="page-title">{labels.indexTitle}</h1>

  {
    posts.length === 0 ? (
      <p class="empty-state">{labels.empty}</p>
    ) : (
      years.map((year) => (
        <section class="year-group">
          <h2 class="year-label">{year}</h2>
          <ul class="post-list" role="list">
            {postsByYear[year].map((post) => (
              <li class="post-item">
                <a href={getPostUrl(post)} class="post-link">
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-date">{formatPostDate(post.data.pubDate, locale)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</div>

<style>
  .posts-page {
    padding-block: 4rem;
  }

  .page-title {
    font-size: var(--text-2xl);
    font-family: var(--font-heading);
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: 3rem;
  }

  .empty-state {
    color: var(--fg-muted);
    font-style: italic;
  }

  .year-group {
    margin-bottom: 2.5rem;
  }

  .year-label {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .post-list {
    list-style: none;
  }

  .post-item {
    border-bottom: 1px solid var(--border);
  }

  .post-item:first-child {
    border-top: 1px solid var(--border);
  }

  .post-link {
    align-items: baseline;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding-block: 0.875rem;
    text-decoration: none;
  }

  .post-title {
    color: var(--fg);
    font-size: var(--text-base);
    font-weight: 500;
    transition: color var(--transition);
  }

  .post-link:hover .post-title {
    color: var(--accent);
  }

  .post-date {
    color: var(--fg-muted);
    flex-shrink: 0;
    font-size: var(--text-sm);
    white-space: nowrap;
  }
</style>
