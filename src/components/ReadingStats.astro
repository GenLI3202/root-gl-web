---
import type { Locale } from "@/i18n";
import { READING_STATS } from "@/data/library";
import { seeded, sketchCurve, sketchRect, sketchSegment, type Point } from "@/utils/sketch";

/**
 * Reading numbers from WeChat Reading: headline counts, hours per year as a pen-drawn
 * curve, and reading time by hour of day as pen-drawn columns. Each chart has a hover and
 * focus tooltip per year or hour, and a table with the same numbers. A chart is one tab stop;
 * arrow keys, Home and End move between its years or hours.
 */
interface Props {
  locale: Locale;
}

interface StatsCopy {
  heading: string;
  synced: string;
  hours: string;
  days: string;
  booksRead: string;
  finished: string;
  notes: string;
  yearTitle: string;
  soFar: string;
  hourTitle: string;
  peak: (hour: number) => string;
  table: string;
  colYear: string;
  colHours: string;
  colTime: string;
}

interface Tile {
  value: number;
  label: string;
}

const { locale } = Astro.props;

const COPY: Record<Locale, StatsCopy> = {
  en: {
    heading: "Reading, by the numbers",
    synced: "synced daily from WeChat Reading",
    hours: "hours read",
    days: "reading days",
    booksRead: "books read",
    finished: "books finished",
    notes: "notes & highlights",
    yearTitle: "Hours per year",
    soFar: "so far",
    hourTitle: "Time of day (Munich time)",
    peak: (h) => `most around ${h}:00`,
    table: "Show the numbers",
    colYear: "Year",
    colHours: "Hours",
    colTime: "Time",
  },
  zh: {
    heading: "阅读数据",
    synced: "每天从微信读书同步",
    hours: "累计小时",
    days: "阅读天数",
    booksRead: "读过的书",
    finished: "读完的书",
    notes: "笔记与划线",
    yearTitle: "每年读了多少小时",
    soFar: "至今",
    hourTitle: "一天里什么时候读（慕尼黑时间）",
    peak: (h) => `最常在 ${h} 点`,
    table: "看数据表",
    colYear: "年份",
    colHours: "小时",
    colTime: "时段",
  },
  de: {
    heading: "Lesen in Zahlen",
    synced: "täglich aus WeChat Reading synchronisiert",
    hours: "Stunden gelesen",
    days: "Lesetage",
    booksRead: "Bücher gelesen",
    finished: "Bücher beendet",
    notes: "Notizen & Markierungen",
    yearTitle: "Lesestunden pro Jahr",
    soFar: "bisher",
    hourTitle: "Tageszeit (Münchner Zeit)",
    peak: (h) => `meist gegen ${h} Uhr`,
    table: "Zahlen anzeigen",
    colYear: "Jahr",
    colHours: "Stunden",
    colTime: "Uhrzeit",
  },
};

const LOCALE_TAGS: Record<Locale, string> = { en: "en-GB", zh: "zh-CN", de: "de-DE" };
/** The hour-of-day chart starts in the morning, so night reading sits together at the end */
const DAY_START_HOUR = 6;

const copy = COPY[locale];
const fmt = new Intl.NumberFormat(LOCALE_TAGS[locale]);
const stats = READING_STATS;
const hoursOf = (seconds: number): number => Math.round(seconds / 3600);

const tiles: Tile[] = [
  { value: hoursOf(stats.totalSeconds), label: copy.hours },
  { value: stats.readDays, label: copy.days },
  { value: stats.booksRead, label: copy.booksRead },
  { value: stats.booksFinished, label: copy.finished },
  { value: stats.notes, label: copy.notes },
];

/** Round up to a gridline step that leaves two or three lines */
function niceMax(max: number): { top: number; step: number } {
  const step = [10, 20, 25, 50, 100, 200, 250, 500].find((s) => max / s <= 3) ?? 1000;
  return { top: Math.max(step, Math.ceil(max / step) * step), step };
}

// ── Hours per year ──
const YW = 440;
const YH = 260;
const Y_PAD = { left: 44, right: 22, top: 40, bottom: 36 };
const yPlotW = YW - Y_PAD.left - Y_PAD.right;
const yPlotH = YH - Y_PAD.top - Y_PAD.bottom;
const yBase = Y_PAD.top + yPlotH;

const years = stats.years.map((y) => ({ year: y.year, hours: hoursOf(y.seconds) }));
const yearScale = niceMax(Math.max(1, ...years.map((y) => y.hours)));
const yearStep = years.length > 1 ? yPlotW / (years.length - 1) : 0;
const yearX = (i: number): number =>
  years.length > 1 ? Y_PAD.left + i * yearStep : Y_PAD.left + yPlotW / 2;
const yearY = (hours: number): number => yBase - (hours / yearScale.top) * yPlotH;
const yearPoints: Point[] = years.map((y, i) => [yearX(i), yearY(y.hours)]);
const lastIndex = years.length - 1;
const partial = years.length > 0 && years[lastIndex].year === new Date().getFullYear();
const peakIndex = years.reduce((best, y, i) => (y.hours > years[best].hours ? i : best), 0);
const solidPoints = partial ? yearPoints.slice(0, -1) : yearPoints;
// The last label sits below its point when the line arrives from above and there is room
const lastPoint = yearPoints[lastIndex];
const lastLabelBelow =
  lastIndex > 0 && yearPoints[lastIndex - 1][1] < lastPoint[1] && lastPoint[1] + 28 < yBase;

const yearRand = seeded(2026);
const yearLine = sketchCurve(solidPoints, yearRand);
const yearPartialLine =
  partial && years.length > 1
    ? sketchSegment(yearPoints[lastIndex - 1], yearPoints[lastIndex], yearRand, 1.2)
    : "";
const yearArea =
  years.length > 1
    ? `${sketchCurve(yearPoints, seeded(7), 0)} L${yearX(lastIndex)} ${yBase} L${yearX(0)} ${yBase} Z`
    : "";
const yearGrid = Array.from(
  { length: yearScale.top / yearScale.step },
  (_, i) => (i + 1) * yearScale.step
);
const yearAxis = sketchSegment([Y_PAD.left - 10, yBase], [YW - Y_PAD.right + 8, yBase], yearRand, 1);

// ── Time of day ──
const HW = 440;
const HH = 220;
const H_PAD = { left: 10, right: 10, top: 44, bottom: 34 };
const hPlotW = HW - H_PAD.left - H_PAD.right;
const hPlotH = HH - H_PAD.top - H_PAD.bottom;
const hBase = H_PAD.top + hPlotH;
const hStep = hPlotW / 24;

const dayOrder = Array.from({ length: 24 }, (_, i) => (i + DAY_START_HOUR) % 24);
const hourMax = Math.max(1, ...stats.hours);
const hourRand = seeded(24);
const hourBars = stats.hours.length
  ? dayOrder.map((hour, i) => {
      const seconds = stats.hours[hour];
      const h = Math.max(1.5, (seconds / hourMax) * hPlotH);
      const x = H_PAD.left + i * hStep + 2;
      const w = hStep - 4;
      return { hour, x, w, y: hBase - h, h, hours: hoursOf(seconds), outline: sketchRect(x, hBase - h, w, h, hourRand, 0.7) };
    })
  : [];
const peakBar = hourBars.reduce((best, b) => (b.h > best.h ? b : best), hourBars[0]);
const peakLeft = peakBar ? peakBar.x + peakBar.w / 2 > HW / 2 : false;
const peakNote = peakBar
  ? {
      x: peakBar.x + peakBar.w / 2 + (peakLeft ? -18 : 18),
      y: Math.max(20, peakBar.y - 14),
      arrow: `M${peakBar.x + peakBar.w / 2 + (peakLeft ? -14 : 14)} ${Math.max(20, peakBar.y - 14) + 4} Q${peakBar.x + peakBar.w / 2 + (peakLeft ? -4 : 4)} ${Math.max(20, peakBar.y - 14) + 4} ${peakBar.x + peakBar.w / 2} ${peakBar.y - 4}`,
    }
  : null;
const hourAxis = sketchSegment([H_PAD.left - 4, hBase], [HW - H_PAD.right + 4, hBase], hourRand, 1);
const pad2 = (n: number): string => String(n).padStart(2, "0");
const hourRange = (hour: number): string => `${pad2(hour)}:00–${pad2((hour + 1) % 24)}:00`;
---

<section class="reading-stats" aria-labelledby="reading-stats-heading">
  <div class="stats-head">
    <h2 class="stats-heading" id="reading-stats-heading">{copy.heading}</h2>
    <p class="stats-synced hand">
      <a href="https://weread.qq.com/" target="_blank" rel="noopener noreferrer">{copy.synced} ↗</a>
    </p>
  </div>

  <ul class="tiles" role="list">
    {tiles.map((tile) => (
      <li class="tile">
        <span class="tile-value">{fmt.format(tile.value)}</span>
        <span class="tile-label">{tile.label}</span>
      </li>
    ))}
  </ul>

  <div class="charts">
    {years.length > 0 && (
      <figure class="chart" data-chart>
        <figcaption class="chart-title">{copy.yearTitle}</figcaption>
        <svg viewBox={`0 0 ${YW} ${YH}`} class="chart-svg" role="group" aria-label={copy.yearTitle}>
          <defs>
            <pattern id="reading-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <path class="hatch-line" d="M0 0 V7" />
            </pattern>
          </defs>
          {yearGrid.map((value) => (
            <g class="grid">
              <path d={`M${Y_PAD.left} ${yearY(value)} H${YW - Y_PAD.right}`} />
              <text x={Y_PAD.left - 8} y={yearY(value) + 5} text-anchor="end">{value} h</text>
            </g>
          ))}
          {yearArea && <path class="year-area" d={yearArea} />}
          <g class="ink" filter="url(#hand-wobble)">
            <path d={yearAxis} />
            <path class="year-line" d={yearLine} />
            {yearPartialLine && <path class="year-line partial" d={yearPartialLine} />}
          </g>
          {yearPoints.map(([x, y], i) => (
            <circle
              class:list={["dot", { peak: i === peakIndex, current: partial && i === lastIndex }]}
              cx={x}
              cy={y}
              r="4.5"
            />
          ))}
          {peakIndex !== lastIndex && (
            <text class="note" x={yearPoints[peakIndex][0]} y={yearPoints[peakIndex][1] - 12} text-anchor="middle">
              {years[peakIndex].hours} h
            </text>
          )}
          <text
            class="note"
            x={lastPoint[0] + 4}
            y={lastLabelBelow ? lastPoint[1] + 26 : lastPoint[1] - 14}
            text-anchor="end"
          >
            {years[lastIndex].hours} h{partial && ` ${copy.soFar}`}
          </text>
          {years.map((y, i) => (
            <text class="axis-label" x={yearX(i)} y={YH - 10} text-anchor="middle">{y.year}</text>
          ))}
          {years.map((y, i) => (
            <g
              class="hit"
              tabindex={i === 0 ? "0" : "-1"}
              role="img"
              aria-label={`${y.year}: ${y.hours} h`}
              data-tip={`${y.year} · ${y.hours} h${partial && i === lastIndex ? ` ${copy.soFar}` : ""}`}
            >
              <rect x={yearX(i) - Math.max(yearStep, 24) / 2} y={Y_PAD.top - 10} width={Math.max(yearStep, 24)} height={yPlotH + 10} />
              <path class="crosshair" d={`M${yearX(i)} ${Y_PAD.top - 6} V${yBase}`} />
            </g>
          ))}
        </svg>
        <p class="chart-tip" data-chart-tip hidden></p>
        <details class="chart-table">
          <summary>{copy.table}</summary>
          <table>
            <thead><tr><th scope="col">{copy.colYear}</th><th scope="col">{copy.colHours}</th></tr></thead>
            <tbody>
              {years.map((y, i) => (
                <tr><td>{y.year}{partial && i === lastIndex && ` (${copy.soFar})`}</td><td>{fmt.format(y.hours)}</td></tr>
              ))}
            </tbody>
          </table>
        </details>
      </figure>
    )}

    {hourBars.length > 0 && (
      <figure class="chart" data-chart>
        <figcaption class="chart-title">{copy.hourTitle}</figcaption>
        <svg viewBox={`0 0 ${HW} ${HH}`} class="chart-svg" role="group" aria-label={copy.hourTitle}>
          {hourBars.map((b) => (
            <rect class:list={["bar", { peak: b === peakBar }]} x={b.x} y={b.y} width={b.w} height={b.h} />
          ))}
          <g class="ink" filter="url(#hand-wobble)">
            {hourBars.map((b) => <path class="bar-outline" d={b.outline} />)}
            <path d={hourAxis} />
          </g>
          {peakNote && (
            <g class="peak-note">
              <path class="note-arrow" d={peakNote.arrow} />
              <text class="note" x={peakNote.x} y={peakNote.y} text-anchor={peakLeft ? "end" : "start"}>
                {copy.peak(peakBar.hour)}
              </text>
            </g>
          )}
          {hourBars.map((b) =>
            b.hour % 6 === 0 ? (
              <text class="axis-label" x={b.x + b.w / 2} y={HH - 10} text-anchor="middle">{b.hour}:00</text>
            ) : null
          )}
          {hourBars.map((b, i) => (
            <g
              class="hit"
              tabindex={i === 0 ? "0" : "-1"}
              role="img"
              aria-label={`${hourRange(b.hour)}: ${b.hours} h`}
              data-tip={`${hourRange(b.hour)} · ${b.hours} h`}
            >
              <rect x={b.x - 2} y={H_PAD.top - 10} width={hStep} height={hPlotH + 10} />
              <path class="crosshair" d={`M${b.x + b.w / 2} ${H_PAD.top - 6} V${hBase}`} />
            </g>
          ))}
        </svg>
        <p class="chart-tip" data-chart-tip hidden></p>
        <details class="chart-table">
          <summary>{copy.table}</summary>
          <table>
            <thead><tr><th scope="col">{copy.colTime}</th><th scope="col">{copy.colHours}</th></tr></thead>
            <tbody>
              {hourBars.map((b) => (
                <tr><td>{hourRange(b.hour)}</td><td>{fmt.format(b.hours)}</td></tr>
              ))}
            </tbody>
          </table>
        </details>
      </figure>
    )}
  </div>
</section>

<script>
  function initReadingCharts(): void {
    document.querySelectorAll<HTMLElement>("[data-chart]").forEach((figure) => {
      const tip = figure.querySelector<HTMLElement>("[data-chart-tip]");
      if (!tip) return;

      const show = (target: SVGGElement): void => {
        const frame = figure.getBoundingClientRect();
        const box = target.getBoundingClientRect();
        tip.textContent = target.dataset.tip ?? "";
        tip.style.left = `${box.left - frame.left + box.width / 2}px`;
        tip.style.top = `${box.top - frame.top}px`;
        tip.hidden = false;
      };
      const hide = (): void => {
        tip.hidden = true;
      };

      const targets = Array.from(figure.querySelectorAll<SVGGElement>("[data-tip]"));
      const KEY_STEPS: Record<string, (i: number) => number> = {
        ArrowRight: (i) => Math.min(targets.length - 1, i + 1),
        ArrowDown: (i) => Math.min(targets.length - 1, i + 1),
        ArrowLeft: (i) => Math.max(0, i - 1),
        ArrowUp: (i) => Math.max(0, i - 1),
        Home: () => 0,
        End: () => targets.length - 1,
      };

      targets.forEach((target, index) => {
        target.addEventListener("pointerenter", () => show(target));
        target.addEventListener("focus", () => show(target));
        target.addEventListener("pointerleave", hide);
        target.addEventListener("blur", hide);
        // Roving focus: the point last visited is the chart's one tab stop
        target.addEventListener("keydown", (event) => {
          const step = KEY_STEPS[event.key];
          if (!step) return;
          event.preventDefault();
          const next = targets[step(index)];
          targets.forEach((t) => t.setAttribute("tabindex", t === next ? "0" : "-1"));
          next.focus();
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initReadingCharts);
</script>

<style>
  .reading-stats {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .stats-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .stats-heading {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
  }

  .stats-synced {
    font-size: 1.15rem;
    color: var(--fg-muted);
  }

  .stats-synced a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dashed currentColor;
    transition: color var(--transition);
  }

  .stats-synced a:hover,
  .stats-synced a:focus-visible {
    color: var(--accent);
  }

  /* ── Headline numbers ── */
  .tiles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: 1rem;
  }

  /* Where the tiles wrap two by two, total hours takes the whole first row */
  @media (max-width: 40rem) {
    .tile:first-child {
      grid-column: 1 / -1;
    }
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 0.6rem;
    border-top: 1.5px solid var(--fg);
  }

  .tile-value {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .tile-label {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /* ── Charts ── */
  .charts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2rem 2.5rem;
  }

  .chart {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
  }

  .chart-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .chart-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .chart-svg text {
    font-family: var(--font-hand);
    fill: var(--fg);
  }

  .grid path {
    stroke: var(--border-dark);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }

  .grid text,
  .axis-label {
    font-size: 17px;
    fill: var(--fg-muted);
  }

  .chart-svg .axis-label {
    fill: var(--fg-muted);
  }

  /* On a phone the charts shrink to about three quarters, so labels are drawn larger */
  @media (max-width: 30rem) {
    .grid text,
    .axis-label {
      font-size: 21px;
    }

    .chart-svg .note {
      font-size: 23px;
    }
  }

  .hatch-line {
    stroke: var(--fg);
    stroke-width: 1;
    opacity: 0.2;
  }

  .year-area {
    fill: url(#reading-hatch);
  }

  .ink path {
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ink .year-line {
    stroke-width: 2.2;
  }

  .ink .year-line.partial {
    stroke-dasharray: 5 6;
  }

  .dot {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 2;
  }

  .dot.peak {
    fill: var(--fg);
  }

  .dot.current {
    fill: var(--accent);
    stroke: var(--accent);
  }

  /* A paper-coloured halo keeps notes legible where they cross a line */
  .note {
    font-size: 20px;
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  .note-arrow {
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .bar {
    fill: var(--border-dark);
  }

  .bar.peak {
    fill: var(--accent);
  }

  .ink .bar-outline {
    stroke-width: 1.1;
  }

  .hit {
    cursor: default;
    outline: none;
  }

  .hit rect {
    fill: transparent;
  }

  .crosshair {
    stroke: var(--fg-muted);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0;
    transition: opacity var(--transition);
  }

  .hit:hover .crosshair,
  .hit:focus-visible .crosshair {
    opacity: 1;
  }

  .hit:focus-visible rect {
    fill: var(--accent-soft);
  }

  .chart-tip {
    position: absolute;
    z-index: 2;
    transform: translate(-50%, calc(-100% - 4px));
    padding: 0.2rem 0.55rem;
    font-size: var(--text-xs);
    font-weight: 500;
    white-space: nowrap;
    color: var(--bg);
    background: var(--fg);
    border-radius: var(--radius-sm);
    pointer-events: none;
  }

  .chart-tip[hidden] {
    display: none;
  }

  .chart-table summary {
    width: fit-content;
    font-size: var(--text-xs);
    color: var(--fg-muted);
    cursor: pointer;
  }

  .chart-table summary:hover,
  .chart-table summary:focus-visible {
    color: var(--fg);
  }

  .chart-table table {
    margin-top: 0.5rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .chart-table th,
  .chart-table td {
    padding: 0.2rem 1.25rem 0.2rem 0;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .chart-table th {
    font-weight: 600;
    color: var(--fg-muted);
  }
</style>
