---
import type { BookCategory } from "@/data/books";
import { toHours, type ShelfBook } from "@/data/library";

/**
 * Close-up of one bookcase, shown in the reading-room stage after the camera has moved in.
 * Spine width follows reading hours, a red ribbon marks books read in the last 30 days, and
 * each spine opens its book's dialog (wired up by ReadingRoom's script).
 */
interface Props {
  category: BookCategory;
  books: ShelfBook[];
  label: string;
  count: string;
  back: string;
  legend: string;
  /** Width of this case relative to the widest one, 0–1 */
  share: number;
  /** Longest reading time in the library, for scaling spine width */
  maxSeconds: number;
}

const { category, books, label, count, back, legend, share, maxSeconds } = Astro.props;

// Spine heights cycle so a shelf looks hand-stacked, not uniform
const SPINE_HEIGHTS = [150, 134, 158, 140, 128, 152, 138];
const MAX_SPINE_HEIGHT = 196;
const CJK = /[㐀-鿿]/;

function spineWidth(book: ShelfBook): number {
  if (!book.reading || maxSeconds === 0) return 40;
  return Math.round(34 + 26 * Math.sqrt(book.reading.seconds / maxSeconds));
}

/** Cycled height, raised so the vertical title and the hours label both fit */
function spineHeight(book: ShelfBook, index: number): number {
  const perChar = CJK.test(book.title) ? 17 : 8.5;
  const needed = book.title.length * perChar + (book.reading ? 58 : 34);
  return Math.min(MAX_SPINE_HEIGHT, Math.max(SPINE_HEIGHTS[index % SPINE_HEIGHTS.length], needed));
}
---

<section
  class="case-view"
  id={`case-${category}`}
  data-case-view={category}
  aria-labelledby={`case-${category}-title`}
  style={`--spine: var(--shelf-${category}); --case-share: ${share.toFixed(3)};`}
  hidden
>
  <div class="case-head">
    <button type="button" class="case-back" data-close-case>← {back}</button>
    <h3 class="case-title" id={`case-${category}-title`} tabindex="-1">
      {label}
      <span class="case-count hand">{count}</span>
    </h3>
    <p class="case-legend">{legend}</p>
  </div>
  <ul class="case-shelf" role="list">
    {books.map((book, i) => (
      <li class="case-slot">
        <button
          type="button"
          class="spine"
          data-open-book={book.id}
          aria-haspopup="dialog"
          aria-controls={`book-${book.id}`}
          style={`--spine-w: ${spineWidth(book)}px; --spine-h: ${spineHeight(book, i)}px;`}
        >
          {book.recent && <span class="spine-ribbon" aria-hidden="true"></span>}
          <span class="spine-title" lang={CJK.test(book.title) ? "zh" : undefined}>
            {book.title}
          </span>
          {book.reading && <span class="spine-hours hand">{toHours(book.reading.seconds)}h</span>}
        </button>
      </li>
    ))}
  </ul>
</section>

<style>
  /*
   * Shares the stage's grid cell with the room. As wide relative to the stage as the case is
   * relative to the widest one, and centred where the camera came to rest.
   */
  .case-view {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-self: start;
    justify-self: center;
    width: max(min(100%, 26rem), calc(var(--case-share) * 100%));
    padding: 1rem;
    opacity: 0;
    transform: scale(0.96) translateY(10px);
    pointer-events: none;
    transition:
      opacity 260ms ease,
      transform 360ms var(--ease-out);
  }

  .case-view[hidden] {
    display: none;
  }

  :global(.room-stage.is-zoomed) .case-view {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition:
      opacity 320ms ease 520ms,
      transform 420ms var(--ease-out) 520ms;
  }

  /* Back button, title and legend share one line where it is wide enough */
  .case-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
  }

  .case-back {
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    padding: 0.3rem 0.8rem;
    color: var(--fg-muted);
    background: var(--bg);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition);
  }

  .case-back:hover,
  .case-back:focus-visible {
    border-color: var(--fg);
    color: var(--fg);
  }

  .case-back:active {
    transform: scale(0.97);
  }

  .case-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    outline: none;
  }

  .case-count {
    white-space: nowrap;
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--fg-muted);
  }

  .case-legend {
    flex: 1 1 18rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /*
   * The bookcase seen square-on: a rosewood frame, cornice and base around dark recessed shelves.
   * Each row is one shelf; the gradient draws a plank under every row.
   */
  .case-shelf {
    --row: 216px;
    --plank: 9px;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    padding: 0 0.75rem;
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0 calc(var(--row) - var(--plank)),
        var(--wood-top) calc(var(--row) - var(--plank)) calc(var(--row) - var(--plank) + 2px),
        var(--wood) calc(var(--row) - var(--plank) + 2px) var(--row)
      ),
      linear-gradient(to bottom, var(--wood-line), transparent 3.5rem),
      var(--wood-recess);
    border: 10px solid var(--wood);
    border-top-width: 18px;
    border-bottom-width: 14px;
    border-radius: var(--radius-sm);
    box-shadow:
      inset 0 0 0 1px var(--wood-line),
      0 -2px 0 var(--wood-top);
  }

  /*
   * On narrow stages the case is one long shelf that pans sideways, so the close-up stays
   * no taller than the room and the Back button stays in view.
   */
  @container room (max-width: 760px) {
    .case-view {
      width: 100%;
    }

    .case-shelf {
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
      scrollbar-color: var(--wood-top) var(--wood-recess);
      /* Headroom for ribbons and lifted spines, which the scroller would otherwise clip */
      padding-top: 1rem;
      background-position: 0 1rem;
      background-size: 100% var(--row);
      background-repeat: no-repeat;
    }

    .case-slot {
      flex: none;
      scroll-snap-align: start;
    }
  }

  .case-slot {
    display: flex;
    align-items: flex-end;
    height: var(--row);
    padding: 0 2px var(--plank);
  }

  .spine {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: var(--spine-w);
    height: var(--spine-h);
    padding: 0.8rem 0 0.55rem;
    background: var(--spine);
    border: 1.5px solid var(--wood-line);
    border-bottom: none;
    border-radius: 3px 3px 0 0;
    color: var(--fg);
    font: inherit;
    cursor: pointer;
    transition:
      transform 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out);
  }

  /* Two thin bands near the top and bottom, like printed spine decoration */
  .spine::before,
  .spine::after {
    content: "";
    position: absolute;
    left: 0.35rem;
    right: 0.35rem;
    height: 0;
    border-top: 1px solid var(--fg);
    opacity: 0.35;
  }

  .spine::before {
    top: 0.4rem;
  }

  .spine::after {
    bottom: 0.3rem;
  }

  .spine:hover,
  .spine:focus-visible {
    transform: translateY(-8px) rotate(-1.5deg);
    box-shadow: var(--shadow-hover);
  }

  .spine:focus-visible {
    outline-color: var(--accent);
  }

  .spine:active {
    transform: translateY(-4px);
  }

  .spine-title {
    writing-mode: vertical-rl;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .spine-title:lang(zh) {
    font-family: var(--font-cjk);
    letter-spacing: 0.2em;
  }

  .spine-hours {
    font-size: 1rem;
    line-height: 1;
    color: var(--fg);
  }

  .spine-ribbon {
    position: absolute;
    top: -0.9rem;
    right: 0.45rem;
    width: 0.45rem;
    height: 1.6rem;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
  }

  /* Reduced motion: only a short crossfade between room and close-up */
  @media (prefers-reduced-motion: reduce) {
    .case-view,
    :global(.room-stage.is-zoomed) .case-view {
      transform: none;
      transition: opacity 180ms ease !important;
    }
  }
</style>
