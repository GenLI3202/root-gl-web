---
import type { BookCategory } from "@/data/books";
import type { ShelfBook } from "@/data/library";
import { seeded, seedOf, sketchRect, sketchSegment, type Point } from "@/utils/sketch";

/**
 * Pen drawing of one bookcase in the reading room, on a 200 × 250 canvas. Each book is a
 * spine whose thickness grows with its reading hours; books fill the shelves top to bottom.
 * The first empty shelf gets a potted plant.
 */
interface Props {
  category: BookCategory;
  books: ShelfBook[];
  /** Longest reading time on the whole shelf, for scaling spine thickness */
  maxSeconds: number;
}

interface Spine {
  x: number;
  y: number;
  w: number;
  h: number;
  recent: boolean;
}

const { category, books, maxSeconds } = Astro.props;
const rand = seeded(seedOf(category));

const INNER_LEFT = 24;
const INNER_RIGHT = 176;
const GAP = 1.6;
/** [top, bottom] of each shelf compartment */
const COMPARTMENTS: [number, number][] = [
  [20, 74],
  [78, 128],
  [132, 182],
  [186, 232],
];

function thickness(book: ShelfBook): number {
  if (!book.reading || maxSeconds === 0) return 9;
  return 6 + 9 * Math.sqrt(book.reading.seconds / maxSeconds);
}

const spines: Spine[] = [];
let shelf = 0;
let x = INNER_LEFT + 2;
for (const book of books) {
  const w = thickness(book);
  if (x + w > INNER_RIGHT - 2) {
    shelf += 1;
    x = INNER_LEFT + 2;
  }
  if (shelf >= COMPARTMENTS.length) break;
  const [top, bottom] = COMPARTMENTS[shelf];
  const h = Math.min(bottom - top - 6, 30 + rand() * 16);
  spines.push({ x, y: bottom - h, w, h, recent: book.recent });
  x += w + GAP;
}

const usedShelves = spines.length ? shelf + 1 : 0;
const plantShelf = usedShelves < COMPARTMENTS.length ? COMPARTMENTS[usedShelves] : null;

const seg = (a: Point, b: Point, wobble = 0.8): string => sketchSegment(a, b, rand, wobble);

const frame = [
  sketchRect(6, 8, 188, 10, rand, 0.8),
  sketchRect(14, 18, 172, 222, rand, 1),
  seg([INNER_LEFT, 18], [INNER_LEFT, 232]),
  seg([INNER_RIGHT, 18], [INNER_RIGHT, 232]),
  ...COMPARTMENTS.map(([, bottom]) => seg([INNER_LEFT, bottom], [INNER_RIGHT, bottom], 0.6)),
  ...COMPARTMENTS.slice(0, -1).map(([, bottom]) =>
    seg([INNER_LEFT, bottom + 4], [INNER_RIGHT, bottom + 4], 0.6)
  ),
  seg([22, 240], [22.4, 247]),
  seg([178, 240], [177.6, 247]),
];

function plant([top, bottom]: [number, number]): string[] {
  const cx = 100;
  return [
    seg([cx - 9, bottom - 14], [cx + 9, bottom - 14], 0.4),
    seg([cx + 9, bottom - 14], [cx + 6.5, bottom], 0.4),
    seg([cx + 6.5, bottom], [cx - 6.5, bottom], 0.4),
    seg([cx - 6.5, bottom], [cx - 9, bottom - 14], 0.4),
    `M${cx} ${bottom - 14} C${cx - 2} ${bottom - 24} ${cx - 10} ${top + 16} ${cx - 16} ${top + 12}`,
    `M${cx} ${bottom - 14} C${cx + 1} ${bottom - 26} ${cx + 4} ${top + 10} ${cx + 2} ${top + 6}`,
    `M${cx} ${bottom - 14} C${cx + 3} ${bottom - 22} ${cx + 12} ${top + 20} ${cx + 17} ${top + 17}`,
  ];
}
---

<svg class="bookcase-sketch" viewBox="0 0 200 250" aria-hidden="true" focusable="false">
  <g class="bookcase-fill">
    {spines.map((s) => <rect x={s.x} y={s.y} width={s.w} height={s.h} />)}
  </g>
  <g class="bookcase-ink" filter="url(#hand-wobble)">
    {frame.map((d) => <path d={d} />)}
    {spines.map((s) => <path d={sketchRect(s.x, s.y, s.w, s.h, rand, 0.5)} />)}
    {plantShelf && plant(plantShelf).map((d) => <path d={d} />)}
  </g>
  <g class="bookcase-accent">
    {spines
      .filter((s) => s.recent)
      .map((s) => <path d={`M${s.x + s.w * 0.7} ${s.y - 4} L${s.x + s.w * 0.7} ${s.y + 7}`} />)}
  </g>
</svg>

<style>
  .bookcase-sketch {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .bookcase-fill rect {
    fill: var(--spine);
  }

  .bookcase-ink path {
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bookcase-accent path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
</style>
