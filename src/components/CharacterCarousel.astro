---
import type { Locale } from "@/i18n";

interface Props {
  locale?: Locale;
}

interface Character {
  id: string;
  name: string;
  nameEn: string;
  work: string;
  author: string;
  quote: string;
  translation: string;
  avatar: string;
  slideFrom: "left" | "right";
  /** Gen's own reading of the character, shown as a handwritten margin note */
  note?: Record<Locale, string>;
}

const { locale = "en" } = Astro.props;

const NOTE_LABEL: Record<Locale, string> = {
  en: "my take",
  zh: "我的理解",
  de: "meine Lesart",
};

const characters: Character[] = [
  {
    id: "guo-jing",
    name: "郭靖",
    nameEn: "Guo Jing",
    work: "射雕英雄传",
    author: "金庸 Jin Yong",
    quote: "侠之大者，为国为民。",
    translation: "The greatest of knights serves his country and its people.",
    avatar: "/images/hobbies/guo-jing.svg",
    slideFrom: "left",
  },
  {
    id: "linghu-chong",
    name: "令狐冲",
    nameEn: "Linghu Chong",
    work: "笑傲江湖",
    author: "金庸 Jin Yong",
    quote: "无招胜有招，剑法不在招式，在乎一心。",
    translation: "No move surpasses all moves. The sword lives in the mind, not the form.",
    avatar: "/images/hobbies/linghu-chong.svg",
    slideFrom: "right",
  },
  {
    id: "sinclair",
    name: "Sinclair",
    nameEn: "Sinclair",
    work: "Demian",
    author: "Hermann Hesse",
    quote: "Der Vogel kämpft sich aus dem Ei. Wer geboren werden will, muss eine Welt zerstören.",
    translation: "The bird fights its way out of the egg. He who would be born must first destroy a world.",
    avatar: "/images/hobbies/sinclair.svg",
    slideFrom: "left",
  },
  {
    id: "ye-wenjie",
    name: "叶文洁",
    nameEn: "Ye Wenjie",
    work: "三体",
    author: "刘慈欣 Liu Cixin",
    quote: "到这里来吧，我将帮助你们获得这个世界。我的文明已无力解决自己的问题，需要你们的力量来介入。",
    translation:
      "Come here. I will help you gain this world. My civilization can no longer solve its own problems; it needs your strength to step in.",
    avatar: "/images/hobbies/ye-wenjie.svg",
    slideFrom: "right",
  },
  {
    id: "luo-ji",
    name: "罗辑",
    nameEn: "Luo Ji",
    work: "三体 II · 黑暗森林",
    author: "刘慈欣 Liu Cixin",
    quote: "第一，生存是文明的第一需要。第二，文明不断增长和扩张，但宇宙中的物质总量保持不变。",
    translation:
      "First, survival is the primary need of civilization. Second, civilization keeps growing and expanding, but the total matter in the universe stays constant.",
    avatar: "/images/hobbies/luo-ji.svg",
    slideFrom: "left",
    note: {
      en: "He never asked for the job. Fate picked him, and he became the Swordholder anyway: a saviour by assignment, not ambition.",
      zh: "他从没想当救世主，是命运选中了他。被推到面壁者、执剑人的位置上，他接下了这份躲不开的使命。",
      de: "Er wollte die Rolle nie. Das Schicksal hat ihn ausgewählt, und er wurde trotzdem zum Schwerthalter: ein Retter aus Auftrag, nicht aus Ehrgeiz.",
    },
  },
  {
    id: "zhang-beihai",
    name: "章北海",
    nameEn: "Zhang Beihai",
    work: "三体 II · 黑暗森林",
    author: "刘慈欣 Liu Cixin",
    quote: "没关系的，都一样。",
    translation: "It doesn't matter. It's all the same.",
    avatar: "/images/hobbies/zhang-beihai.svg",
    slideFrom: "right",
    note: {
      en: "Cold, complete rationality in service of humanity as a whole. Which ship survives doesn't matter, as long as someone does.",
      zh: "为了人类整体利益的最大化，可以理性到极致。哪艘船活下来不重要，只要人类还在。",
      de: "Kalte, vollständige Rationalität im Dienst der ganzen Menschheit. Welches Schiff überlebt, ist egal, solange überhaupt jemand überlebt.",
    },
  },
  {
    id: "cheng-xin",
    name: "程心",
    nameEn: "Cheng Xin",
    work: "三体 III · 死神永生",
    author: "刘慈欣 Liu Cixin",
    quote: "我选择人性。",
    translation: "I choose humanity.",
    avatar: "/images/hobbies/cheng-xin.svg",
    slideFrom: "left",
    note: {
      en: "Deep care for every single life. She stands for refusing to sacrifice one person for the greater total, even when the arithmetic says otherwise.",
      zh: "对每一个个体命运的极度关怀。她代表的价值观是：哪怕为了整体利益，也不愿去伤害个人。",
      de: "Tiefe Fürsorge für jedes einzelne Leben. Sie steht dafür, keinen Menschen für das große Ganze zu opfern, auch wenn die Rechnung dafür spricht.",
    },
  },
];

const EPIGRAPH = {
  quote: "给岁月以文明，而不是给文明以岁月。",
  source: "《三体 II · 黑暗森林》",
  translation: {
    en: "Give civilization to the years, not years to civilization.",
    zh: "改写自帕斯卡：给时光以生命，而不是给生命以时光。",
    de: "Gib den Jahren Zivilisation, nicht der Zivilisation Jahre.",
  } as Record<Locale, string>,
};
---

<div class="char-carousel" role="region" aria-label="Literary Characters" data-carousel>
  <div class="carousel-track">
    {characters.map((char, i) => (
      <div
        class="char-card"
        data-index={i}
        data-slide={char.slideFrom}
        aria-hidden={i !== 0 ? "true" : "false"}
      >
        <div class="card-inner">
          <img
            src={char.avatar}
            alt={char.nameEn}
            class="char-avatar"
            loading="lazy"
            width="96"
            height="120"
          />
          <div class="card-content">
            <div class="char-meta">
              <span class="char-name">{char.name}</span>
              {char.name !== char.nameEn && <span class="char-name-en">{char.nameEn}</span>}
              <span class="char-work">{char.work} · {char.author}</span>
            </div>
            <blockquote class="char-quote">
              <span class="qmark" aria-hidden="true">❝</span>{char.quote}<span class="qmark" aria-hidden="true">❞</span>
            </blockquote>
            <p class="char-translation">{char.translation}</p>
            {char.note && (
              <p class="char-note">
                <span class="char-note-label">{NOTE_LABEL[locale]}</span>
                <span class="hand">{char.note[locale]}</span>
              </p>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="carousel-controls">
    <button class="ctrl-btn prev" aria-label="Previous character" disabled>←</button>
    <div class="dots" role="tablist">
      {characters.map((c, i) => (
        <button
          class="dot"
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-label={c.nameEn}
          data-dot={i}
        />
      ))}
    </div>
    <button class="ctrl-btn next" aria-label="Next character">→</button>
  </div>
</div>

<figure class="char-epigraph">
  <blockquote>{EPIGRAPH.quote}</blockquote>
  <figcaption>
    <span class="epigraph-source">— {EPIGRAPH.source}</span>
    <span class="epigraph-translation">{EPIGRAPH.translation[locale]}</span>
  </figcaption>
</figure>

<style>
  .char-carousel {
    border: 1.5px solid var(--border-dark);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 6px 32px rgba(0, 0, 0, 0.18), 0 1px 4px rgba(0, 0, 0, 0.10);
  }

  /* Track */
  .carousel-track {
    position: relative;
    min-height: 200px;
  }

  /* Cards */
  .char-card {
    position: absolute;
    inset: 0;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
  }
  .char-card[aria-hidden="false"] {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  .card-inner {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  @media (max-width: 480px) {
    .card-inner { flex-direction: column; gap: 0.875rem; }
  }

  /* Avatar */
  .char-avatar {
    flex-shrink: 0;
    width: 96px;
    height: 120px;
    object-fit: cover;
    border-radius: var(--radius-md);
    filter: grayscale(100%);
    transition: filter 0.3s ease;
    display: block;
    background: var(--bg);
  }
  .char-card[aria-hidden="false"] .char-avatar:hover {
    filter: grayscale(0%);
  }

  /* Content */
  .card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .char-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.625rem;
  }
  .char-name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--fg);
    line-height: 1.2;
  }
  .char-name-en {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .char-work {
    width: 100%;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /* Quote */
  .char-quote {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--fg);
    line-height: 1.55;
  }
  .qmark {
    font-style: normal;
    color: var(--accent);
    opacity: 0.4;
    font-size: 1.3em;
    line-height: 0;
    vertical-align: -0.25em;
  }
  .qmark:first-child { margin-right: 0.1em; }
  .qmark:last-child  { margin-left: 0.1em; }

  .char-translation {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--fg-muted);
    font-style: italic;
    line-height: 1.6;
    max-width: 52ch;
  }

  /* Gen's margin note */
  .char-note {
    margin: 0.25rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--border-dark);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    max-width: 52ch;
  }
  .char-note-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .char-note .hand {
    font-size: 1.2rem;
    line-height: 1.35;
  }

  /* Epigraph below the carousel */
  .char-epigraph {
    margin: 1.75rem 0 0;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
  }
  .char-epigraph blockquote {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--fg);
    letter-spacing: 0.02em;
  }
  .char-epigraph figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 0.35rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .epigraph-translation {
    font-style: italic;
  }

  /* Controls */
  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.75rem 1.5rem;
    border-top: 1px solid var(--border);
  }

  .ctrl-btn {
    width: 1.875rem;
    height: 1.875rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border-dark);
    background: none;
    color: var(--fg);
    font-size: 0.8125rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .ctrl-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .ctrl-btn:disabled { opacity: 0.28; cursor: not-allowed; }

  .dots {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    border: none;
    padding: 0;
    background: var(--border-dark);
    cursor: pointer;
    transition: background 0.18s, transform 0.18s;
  }
  .dot[aria-selected="true"] {
    background: var(--accent);
    transform: scale(1.4);
  }

  /* Animations */
  @media (prefers-reduced-motion: no-preference) {
    .char-card.in-left  { animation: inLeft  0.38s cubic-bezier(0.22,1,0.36,1) forwards; }
    .char-card.in-right { animation: inRight 0.38s cubic-bezier(0.22,1,0.36,1) forwards; }
    .char-card.out-left  { animation: outLeft  0.26s ease-in forwards; }
    .char-card.out-right { animation: outRight 0.26s ease-in forwards; }

    @keyframes inLeft  { from { opacity:0; transform:translateX(-28px); } to { opacity:1; transform:none; } }
    @keyframes inRight { from { opacity:0; transform:translateX(28px);  } to { opacity:1; transform:none; } }
    @keyframes outLeft  { from { opacity:1; transform:none; } to { opacity:0; transform:translateX(-20px); } }
    @keyframes outRight { from { opacity:1; transform:none; } to { opacity:0; transform:translateX(20px);  } }
  }
  @media (prefers-reduced-motion: reduce) {
    .char-card.in-left, .char-card.in-right {
      animation: fadeIn 0.25s ease forwards;
    }
    @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
  }
</style>

<script>
  function initCarousel() {
    const root = document.querySelector<HTMLElement>('[data-carousel]');
    if (!root) return;

    const cards   = Array.from(root.querySelectorAll<HTMLElement>('.char-card'));
    const dots    = Array.from(root.querySelectorAll<HTMLButtonElement>('.dot'));
    const prevBtn = root.querySelector<HTMLButtonElement>('.prev')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('.next')!;
    const dirs    = cards.map(c => c.dataset.slide as 'left' | 'right');

    let cur = 0;
    let busy = false;

    cards.forEach((c, i) => {
      if (i !== 0) { c.style.opacity = '0'; c.style.pointerEvents = 'none'; }
    });

    function updateControls() {
      prevBtn.disabled = cur === 0;
      nextBtn.disabled = cur === cards.length - 1;
      dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === cur)));
    }

    function go(target: number, fwd: boolean) {
      if (busy || target === cur || target < 0 || target >= cards.length) return;
      busy = true;

      const outCard = cards[cur];
      const inCard  = cards[target];
      const outCls  = fwd ? 'out-left' : 'out-right';
      const inCls   = fwd
        ? (dirs[target] === 'left' ? 'in-left' : 'in-right')
        : (dirs[target] === 'left' ? 'in-right' : 'in-left');

      outCard.classList.add(outCls);
      outCard.addEventListener('animationend', () => {
        outCard.classList.remove(outCls);
        outCard.setAttribute('aria-hidden', 'true');
        outCard.style.opacity = '0';
        outCard.style.pointerEvents = 'none';

        inCard.setAttribute('aria-hidden', 'false');
        inCard.style.opacity = '';
        inCard.style.pointerEvents = '';
        inCard.classList.add(inCls);
        inCard.addEventListener('animationend', () => {
          inCard.classList.remove(inCls);
          busy = false;
        }, { once: true });
      }, { once: true });

      cur = target;
      updateControls();
    }

    prevBtn.addEventListener('click', () => go(cur - 1, false));
    nextBtn.addEventListener('click', () => go(cur + 1, true));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i, i > cur)));

    root.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft')  go(cur - 1, false);
      if (e.key === 'ArrowRight') go(cur + 1, true);
    });

    let tx = 0;
    root.addEventListener('touchstart', e => { tx = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend',   e => {
      const dx = e.changedTouches[0].clientX - tx;
      if (Math.abs(dx) > 40) dx < 0 ? go(cur + 1, true) : go(cur - 1, false);
    });

    updateControls();
  }

  document.addEventListener('astro:page-load', initCarousel);
</script>
