---
import HobbyShell from "@/components/HobbyShell.astro";
import ReadingRoom from "@/components/ReadingRoom.astro";
import ReadingStats from "@/components/ReadingStats.astro";
import type { Locale } from "@/i18n";

/** Hobbies → Reading: the study header inside ReadingRoom serves as the page heading */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<HobbyShell locale={locale} hobby="reading">
  <ReadingRoom locale={locale} />
  <ReadingStats locale={locale} />
</HobbyShell>
