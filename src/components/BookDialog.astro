---
import type { Locale } from "@/i18n";
import { CATEGORY_LABELS, type BookCategory } from "@/data/books";
import { CHARACTERS, type Character } from "@/data/characters";
import { altTitleFor, titleFor, toHours, type ShelfBook } from "@/data/library";

/**
 * Detail card for one book, opened as a modal dialog from its spine in the reading room.
 * A drawn xuan-paper cover sits beside the title, author and WeRead reading facts; Gen's own
 * notes, a kept line and characters follow, and the card ends with a link to WeRead.
 */
interface Props {
  book: ShelfBook;
  locale: Locale;
}

interface DialogCopy {
  close: string;
  recent: string;
  seal: string;
  characters: string;
  keepLine: string;
  myTake: string;
  notes: string;
  openIn: string;
  hoursRead: (hours: string) => string;
  progress: (percent: number) => string;
  finished: (date: string) => string;
  lastOpened: (date: string) => string;
  marks: (highlights: number, thoughts: number) => string;
}

/** Ink motif drawn on the cover */
type CoverMotif = "plum" | "mountains" | "planet";

const { book, locale } = Astro.props;

const COPY: Record<Locale, DialogCopy> = {
  en: {
    close: "Close",
    recent: "Read in the last 30 days",
    seal: "30 days",
    characters: "Memorable characters",
    keepLine: "A line I keep",
    myTake: "my take",
    notes: "Reading notes",
    openIn: "View on WeChat Reading",
    hoursRead: (h) => `About ${h} hours`,
    progress: (p) => `${p}% read`,
    finished: (d) => `Finished ${d}`,
    lastOpened: (d) => `Last opened ${d}`,
    marks: (h, t) => `${h} highlights · ${t} notes`,
  },
  zh: {
    close: "关闭",
    recent: "近 30 天读过",
    seal: "近30天",
    characters: "印象深刻的角色",
    keepLine: "记住的一句",
    myTake: "我的理解",
    notes: "读后感",
    openIn: "在微信读书查看",
    hoursRead: (h) => `约 ${h} 小时`,
    progress: (p) => `读到 ${p}%`,
    finished: (d) => `${d} 读完`,
    lastOpened: (d) => `最近一次 ${d}`,
    marks: (h, t) => `划线 ${h} · 想法 ${t}`,
  },
  de: {
    close: "Schließen",
    recent: "In den letzten 30 Tagen gelesen",
    seal: "30 Tage",
    characters: "Unvergessliche Figuren",
    keepLine: "Ein Satz, der bleibt",
    myTake: "meine Lesart",
    notes: "Lesenotizen",
    openIn: "Bei WeChat Reading ansehen",
    hoursRead: (h) => `Etwa ${h} Stunden`,
    progress: (p) => `zu ${p} % gelesen`,
    finished: (d) => `Beendet am ${d}`,
    lastOpened: (d) => `Zuletzt geöffnet am ${d}`,
    marks: (h, t) => `${h} Markierungen · ${t} Notizen`,
  },
};

const COVER_MOTIFS: Record<BookCategory, CoverMotif> = {
  literature: "plum",
  ideas: "plum",
  polecon: "mountains",
  wuxia: "mountains",
  scifi: "planet",
};

const LOCALE_TAGS: Record<Locale, string> = { en: "en-GB", zh: "zh-CN", de: "de-DE" };

const copy = COPY[locale];
const reading = book.reading;
const dateFormat = new Intl.DateTimeFormat(LOCALE_TAGS[locale], {
  dateStyle: "medium",
  timeZone: "Europe/Berlin",
});
const numberFormat = new Intl.NumberFormat(LOCALE_TAGS[locale]);
const dateOf = (unixSeconds: number): string => dateFormat.format(new Date(unixSeconds * 1000));
const progress = reading ? Math.min(100, Math.max(0, reading.progress)) : 0;

const CJK = /[㐀-鿿]/;
const titleId = `book-${book.id}-title`;
const mainTitle = titleFor(book, locale);
// Outside Chinese pages the full WeRead title, when there is one, already shows the original
const altTitle = locale !== "zh" && book.fullTitle ? undefined : altTitleFor(book, locale);
const motif = COVER_MOTIFS[book.category];

/** Cover title size: short titles stand large in one column, long ones wrap into two */
function coverTitleSize(title: string): number {
  if (!CJK.test(title)) return 1.35;
  if (title.length <= 4) return 2.1;
  if (title.length <= 6) return 1.75;
  return 1.4;
}

function charactersOf(ids: string[] = []): Character[] {
  return ids
    .map((id) => CHARACTERS.find((c) => c.id === id))
    .filter((c): c is Character => Boolean(c));
}
---

<dialog
  class="book-dialog"
  id={`book-${book.id}`}
  aria-labelledby={titleId}
  style={`--spine: var(--shelf-${book.category});`}
>
  <article class="book-sheet">
    <form method="dialog" class="sheet-close-form">
      <button type="submit" class="sheet-close" aria-label={copy.close}>×</button>
    </form>

    <div class="sheet-top">
      <div
        class="cover"
        aria-hidden="true"
        style={`--cover-title: ${coverTitleSize(book.title)}rem;`}
      >
        <svg class="cover-art" viewBox="0 0 120 160" preserveAspectRatio="xMidYMax slice">
          <g class="cover-brush">
            <path
              class="cover-wash"
              d="M0 132c14-12 26-18 38-10 10-14 24-20 36-8 12-8 26-6 46 6v40H0z"
            />
            <path class="cover-wash" d="M0 148c18-10 30-12 44-4 14-8 30-8 50 2l26 14H0z" />
            {motif === "plum" && (
              <>
                <path class="cover-ink" d="M2 22c14 4 22 14 26 30 3 12 8 22 18 30" />
                <path class="cover-ink-thin" d="M14 26c6-6 12-6 18-12M26 46c-8 2-12 8-16 12" />
                <g class="cover-blossom">
                  <circle cx="46" cy="82" r="3.4" />
                  <circle cx="32" cy="14" r="3.2" />
                  <circle cx="10" cy="58" r="3" />
                  <circle cx="30" cy="62" r="3.4" />
                  <circle cx="20" cy="30" r="2.4" />
                </g>
              </>
            )}
            {motif === "mountains" && (
              <>
                <path
                  class="cover-wash-strong"
                  d="M0 120c10-14 18-26 28-22 6-16 16-30 28-18 8-8 18-4 24 6v54H0z"
                />
                <path class="cover-ink-thin" d="M28 98c6-16 16-30 28-18M86 112l10 0l-2 2h-6z" />
              </>
            )}
            {motif === "planet" && (
              <>
                <circle class="cover-moon" cx="32" cy="92" r="14" />
                <ellipse
                  class="cover-ink-thin"
                  cx="32"
                  cy="92"
                  rx="24"
                  ry="6"
                  transform="rotate(-18 32 92)"
                />
                <g class="cover-star">
                  <circle cx="22" cy="30" r="1.2" />
                  <circle cx="12" cy="58" r="1" />
                  <circle cx="44" cy="44" r="1.1" />
                </g>
              </>
            )}
          </g>
        </svg>
        {book.recent && <span class="cover-ribbon" />}
        <span class="cover-title" lang={CJK.test(book.title) ? "zh" : undefined}>
          {book.title}
        </span>
        {book.recent && <span class="cover-seal">{copy.seal}</span>}
      </div>

      <div class="sheet-head">
        <div class="detail-meta">
          <span class="detail-category">{CATEGORY_LABELS[book.category][locale]}</span>
          {book.recent && <span class="detail-recent">{copy.recent}</span>}
        </div>
        <h3 class="detail-title" id={titleId}>
          <span lang={CJK.test(mainTitle) ? "zh" : undefined}>{mainTitle}</span>
          {altTitle && (
            <span class="detail-title-en" lang={CJK.test(altTitle) ? "zh" : undefined}>
              {altTitle}
            </span>
          )}
        </h3>
        {book.fullTitle && <p class="detail-full-title" lang="zh">{book.fullTitle}</p>}
        <p class="detail-author">{book.author}</p>

        {reading && (
          <div class="reading-facts">
            <p class="facts-lead">
              <span class="facts-hours">
                <svg class="facts-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="12" r="8.5" />
                  <path d="M12 7.5V12l3 2" />
                </svg>
                {copy.hoursRead(numberFormat.format(toHours(reading.seconds)))}
              </span>
              <span class="facts-status">
                <svg class="facts-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="12" r="8.5" />
                  <path d="M8.5 12.2l2.4 2.4 4.6-5" />
                </svg>
                {reading.finishedAt
                  ? copy.finished(dateOf(reading.finishedAt))
                  : copy.progress(progress)}
              </span>
            </p>
            <div class="facts-meter" aria-hidden="true">
              <span style={`width: ${progress}%;`}></span>
            </div>
            <ul class="facts-list" role="list">
              <li>{copy.lastOpened(dateOf(reading.lastReadAt))}</li>
              {reading.highlights + reading.thoughts > 0 && (
                <li>{copy.marks(reading.highlights, reading.thoughts)}</li>
              )}
            </ul>
          </div>
        )}
      </div>
    </div>

    {book.about && <p class="detail-about">{book.about[locale]}</p>}

    {book.notes?.[locale] && (
      <div class="detail-notes">
        <span class="detail-label">{copy.notes}</span>
        {book.notes[locale]!.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    )}

    {book.epigraph && (
      <figure class="detail-epigraph">
        <span class="detail-label">{copy.keepLine}</span>
        <blockquote>{book.epigraph.text}</blockquote>
        <figcaption>
          <span>— {book.epigraph.source}</span>
          <span class="epigraph-translation">{book.epigraph.translation[locale]}</span>
        </figcaption>
      </figure>
    )}

    {book.characters && (
      <section class="detail-characters">
        <h4 class="detail-label">{copy.characters}</h4>
        <ul class="character-grid" role="list">
          {charactersOf(book.characters).map((c) => (
            <li class="character">
              <img
                class="character-avatar"
                src={c.avatar}
                alt={c.nameEn}
                width="80"
                height="100"
                loading="lazy"
              />
              <div class="character-body">
                <p class="character-name">
                  {c.name}
                  {c.name !== c.nameEn && <span class="character-name-en">{c.nameEn}</span>}
                </p>
                {c.work !== book.title && <p class="character-work">{c.work}</p>}
                <blockquote class="character-quote">「{c.quote}」</blockquote>
                <p class="character-translation">{c.translation}</p>
                {c.note && (
                  <p class="character-note">
                    <span class="detail-label">{copy.myTake}</span>
                    <span class="hand">{c.note[locale]}</span>
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {reading?.link && (
      <a class="weread-link" href={reading.link} target="_blank" rel="noopener noreferrer">
        <svg class="facts-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3.5 6c3-1 6-.6 8.5 1.2 2.5-1.8 5.5-2.2 8.5-1.2v12c-3-1-6-.6-8.5 1.2" />
          <path d="M12 19.2c-2.5-1.8-5.5-2.2-8.5-1.2V6" />
          <path d="M12 7.2v12" />
        </svg>
        {copy.openIn} ↗
      </a>
    )}
  </article>
</dialog>

<style>
  /* The dialog itself has no padding, so a click whose target is the dialog hit the backdrop */
  .book-dialog {
    width: min(44rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--card-ink);
    overflow: visible;
  }

  .book-dialog::backdrop {
    background: var(--card-scrim);
  }

  /* A cream card with a fine inner rule, like a mounted sheet of xuan paper */
  .book-sheet {
    container: sheet / inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    padding: 1.5rem;
    background: var(--card-paper);
    border: 1px solid var(--card-paper-edge);
    border-radius: var(--radius-md);
    box-shadow:
      inset 0 0 0 5px var(--card-paper),
      inset 0 0 0 6px var(--card-rule),
      var(--card-shadow);
  }

  .book-sheet :focus-visible {
    outline-color: var(--card-red);
  }

  .book-dialog[open] .book-sheet {
    animation: sheet-in 340ms var(--ease-out);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(16px) rotate(-1deg) scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-dialog[open] .book-sheet {
      animation: none;
    }
  }

  .sheet-close-form {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
  }

  .sheet-close {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--card-rule);
    border-radius: var(--radius-pill);
    background: var(--card-paper);
    color: var(--card-ink-muted);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color var(--transition),
      color var(--transition);
  }

  .sheet-close:hover,
  .sheet-close:focus-visible {
    border-color: var(--card-ink);
    color: var(--card-ink);
  }

  .sheet-close:active {
    transform: scale(0.94);
  }

  /* Cover on the left, title and reading facts beside it */
  .sheet-top {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: 1.4rem;
    align-items: start;
  }

  /*
   * The drawn cover: paper shaded at the edges, the category's tint as a binding strip,
   * an ink motif washed in at the foot and the title running down in large type.
   */
  .cover {
    position: relative;
    aspect-ratio: 3 / 4;
    display: flex;
    justify-content: flex-end;
    padding: 1.1rem 0.9rem 0.75rem 1.1rem;
    overflow: hidden;
    background:
      linear-gradient(
        to right,
        var(--spine) 0 0.45rem,
        var(--card-rule) 0.45rem 0.5rem,
        transparent 0.5rem
      ),
      radial-gradient(ellipse at 60% 35%, var(--card-cover-paper), var(--card-cover-shade) 120%);
    border-radius: 2px var(--radius-sm) var(--radius-sm) 2px;
    box-shadow:
      inset 0 0 0 1px var(--card-rule),
      6px 8px 16px -8px var(--closeup-shade);
  }

  .cover-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cover-brush {
    filter: url(#hand-wobble);
  }

  .cover-wash {
    fill: var(--closeup-ink-wash);
  }

  .cover-wash-strong {
    fill: var(--closeup-ink-wash);
    opacity: 0.9;
  }

  .cover-ink,
  .cover-ink-thin {
    fill: none;
    stroke: var(--card-ink);
    stroke-linecap: round;
  }

  .cover-ink {
    stroke-width: 2.6;
  }

  .cover-ink-thin {
    stroke-width: 1.1;
    opacity: 0.75;
  }

  .cover-blossom {
    fill: var(--closeup-blossom);
  }

  .cover-moon {
    fill: var(--card-paper);
    stroke: var(--card-ink);
    stroke-width: 1;
    opacity: 0.85;
  }

  .cover-star {
    fill: var(--card-ink);
  }

  .cover-title {
    position: relative;
    writing-mode: vertical-rl;
    max-block-size: 72%;
    font-family: var(--closeup-spine-font);
    font-size: var(--cover-title);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.12em;
    color: var(--card-ink);
  }

  .cover-ribbon {
    position: absolute;
    top: 0;
    left: 1rem;
    width: 0.55rem;
    height: 2.4rem;
    background: var(--card-red);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 82%, 0 100%);
  }

  .cover-seal {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.15rem 0.3rem;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--card-on-red);
    background: var(--card-red);
    border-radius: 2px;
  }

  .sheet-head {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
    padding-right: 2.25rem;
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .detail-category,
  .detail-recent {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  /* The category chip carries a dot in the category's tint */
  .detail-category {
    background: var(--card-chip);
    color: var(--card-ink-muted);
    border: 1px solid var(--card-rule);
  }

  .detail-category::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--spine);
    box-shadow: inset 0 0 0 1px var(--card-rule);
  }

  .detail-recent {
    background: var(--card-red-soft);
    color: var(--card-red);
    border: 1px solid var(--card-red-soft);
  }

  .detail-title {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: var(--card-ink);
  }

  .detail-title-en {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--card-ink-muted);
  }

  .detail-full-title,
  .detail-author {
    font-size: var(--text-sm);
    color: var(--card-ink-muted);
  }

  .reading-facts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.35rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--card-rule);
  }

  .facts-lead {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--card-ink);
  }

  .facts-hours,
  .facts-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .facts-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .facts-meter {
    height: 5px;
    border-radius: var(--radius-pill);
    background: var(--card-rule);
    overflow: hidden;
  }

  .facts-meter span {
    display: block;
    height: 100%;
    background: var(--card-red);
    border-radius: inherit;
  }

  .facts-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    font-size: var(--text-xs);
    color: var(--card-ink-muted);
  }

  .detail-about {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--card-ink);
  }

  .detail-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--card-ink-muted);
  }

  .detail-notes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--card-rule);
  }

  .detail-notes p {
    color: var(--card-ink);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  /* The kept line sits on a pale cinnabar wash, like the quote panel of a note card */
  .detail-epigraph {
    margin: 0;
    padding: 0.8rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--card-red-soft);
    border-left: 3px solid var(--card-red);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .detail-epigraph blockquote {
    margin: 0;
    font-family: var(--closeup-spine-font);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--card-red);
  }

  .detail-epigraph figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.75rem;
    font-size: var(--text-sm);
    color: var(--card-ink-muted);
  }

  .epigraph-translation {
    font-style: italic;
  }

  .detail-characters {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--card-rule);
  }

  .character-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1.25rem 1.5rem;
  }

  .character {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .character-avatar {
    flex-shrink: 0;
    width: 80px;
    height: 100px;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--card-rule);
  }

  .character-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .character-name {
    color: var(--card-ink);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.5rem;
  }

  .character-name-en,
  .character-work {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--card-ink-muted);
  }

  .character-quote {
    margin: 0;
    color: var(--card-ink);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .character-translation {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--card-ink-muted);
    line-height: 1.55;
  }

