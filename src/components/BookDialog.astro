---
import type { Locale } from "@/i18n";
import { CATEGORY_LABELS } from "@/data/books";
import { CHARACTERS, type Character } from "@/data/characters";
import { toHours, type ShelfBook } from "@/data/library";

/**
 * Detail card for one book, opened as a modal dialog from its spine in the reading room.
 * Shows WeRead reading facts when synced, then Gen's own notes, a kept line and characters.
 */
interface Props {
  book: ShelfBook;
  locale: Locale;
}

interface DialogCopy {
  close: string;
  recent: string;
  characters: string;
  keepLine: string;
  myTake: string;
  notes: string;
  openIn: string;
  hoursRead: (hours: string) => string;
  progress: (percent: number) => string;
  finished: (date: string) => string;
  lastOpened: (date: string) => string;
  marks: (highlights: number, thoughts: number) => string;
}

const { book, locale } = Astro.props;

const COPY: Record<Locale, DialogCopy> = {
  en: {
    close: "Close",
    recent: "Recently read",
    characters: "Memorable characters",
    keepLine: "A line I keep",
    myTake: "my take",
    notes: "Reading notes",
    openIn: "View on WeChat Reading",
    hoursRead: (h) => `${h} h read`,
    progress: (p) => `${p}% read`,
    finished: (d) => `Finished ${d}`,
    lastOpened: (d) => `Last opened ${d}`,
    marks: (h, t) => `${h} highlights · ${t} notes`,
  },
  zh: {
    close: "关闭",
    recent: "最近读的",
    characters: "印象深刻的角色",
    keepLine: "记住的一句",
    myTake: "我的理解",
    notes: "读后感",
    openIn: "在微信读书查看",
    hoursRead: (h) => `读了 ${h} 小时`,
    progress: (p) => `读到 ${p}%`,
    finished: (d) => `${d} 读完`,
    lastOpened: (d) => `最近一次 ${d}`,
    marks: (h, t) => `划线 ${h} · 想法 ${t}`,
  },
  de: {
    close: "Schließen",
    recent: "Kürzlich gelesen",
    characters: "Unvergessliche Figuren",
    keepLine: "Ein Satz, der bleibt",
    myTake: "meine Lesart",
    notes: "Lesenotizen",
    openIn: "Bei WeChat Reading ansehen",
    hoursRead: (h) => `${h} Std. gelesen`,
    progress: (p) => `zu ${p} % gelesen`,
    finished: (d) => `Beendet am ${d}`,
    lastOpened: (d) => `Zuletzt geöffnet am ${d}`,
    marks: (h, t) => `${h} Markierungen · ${t} Notizen`,
  },
};

const LOCALE_TAGS: Record<Locale, string> = { en: "en-GB", zh: "zh-CN", de: "de-DE" };

const copy = COPY[locale];
const reading = book.reading;
const dateFormat = new Intl.DateTimeFormat(LOCALE_TAGS[locale], {
  dateStyle: "medium",
  timeZone: "Europe/Berlin",
});
const numberFormat = new Intl.NumberFormat(LOCALE_TAGS[locale]);
const dateOf = (unixSeconds: number): string => dateFormat.format(new Date(unixSeconds * 1000));
const progress = reading ? Math.min(100, Math.max(0, reading.progress)) : 0;

const CJK = /[㐀-鿿]/;
const titleId = `book-${book.id}-title`;

function charactersOf(ids: string[] = []): Character[] {
  return ids
    .map((id) => CHARACTERS.find((c) => c.id === id))
    .filter((c): c is Character => Boolean(c));
}
---

<dialog
  class="book-dialog"
  id={`book-${book.id}`}
  aria-labelledby={titleId}
  style={`--spine: var(--shelf-${book.category});`}
>
  <article class="book-sheet">
    <form method="dialog" class="sheet-close-form">
      <button type="submit" class="sheet-close" aria-label={copy.close}>×</button>
    </form>

    <div class="detail-meta">
      <span class="detail-category">{CATEGORY_LABELS[book.category][locale]}</span>
      {book.recent && <span class="detail-recent">{copy.recent}</span>}
    </div>
    <h3 class="detail-title" id={titleId}>
      <span lang={CJK.test(book.title) ? "zh" : undefined}>{book.title}</span>
      {book.titleEn && book.titleEn !== book.title && (
        <span class="detail-title-en">{book.titleEn}</span>
      )}
    </h3>
    {book.fullTitle && <p class="detail-full-title" lang="zh">{book.fullTitle}</p>}
    <p class="detail-author">{book.author}</p>

    {reading && (
      <div class="reading-facts">
        <p class="facts-hours hand">{copy.hoursRead(numberFormat.format(toHours(reading.seconds)))}</p>
        <div class="facts-meter" aria-hidden="true">
          <span style={`width: ${progress}%;`}></span>
        </div>
        <ul class="facts-list" role="list">
          <li>
            {reading.finishedAt ? copy.finished(dateOf(reading.finishedAt)) : copy.progress(progress)}
          </li>
          <li>{copy.lastOpened(dateOf(reading.lastReadAt))}</li>
          {reading.highlights + reading.thoughts > 0 && (
            <li>{copy.marks(reading.highlights, reading.thoughts)}</li>
          )}
        </ul>
      </div>
    )}

    {book.about && <p class="detail-about">{book.about[locale]}</p>}

    {book.notes?.[locale] && (
      <div class="detail-notes">
        <span class="detail-label">{copy.notes}</span>
        {book.notes[locale]!.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    )}

    {book.epigraph && (
      <figure class="detail-epigraph">
        <span class="detail-label">{copy.keepLine}</span>
        <blockquote>{book.epigraph.text}</blockquote>
        <figcaption>
          <span>— {book.epigraph.source}</span>
          <span class="epigraph-translation">{book.epigraph.translation[locale]}</span>
        </figcaption>
      </figure>
    )}

    {book.characters && (
      <section class="detail-characters">
        <h4 class="detail-label">{copy.characters}</h4>
        <ul class="character-grid" role="list">
          {charactersOf(book.characters).map((c) => (
            <li class="character">
              <img class="character-avatar" src={c.avatar} alt={c.nameEn} width="80" height="100" loading="lazy" />
              <div class="character-body">
                <p class="character-name">
                  {c.name}
                  {c.name !== c.nameEn && <span class="character-name-en">{c.nameEn}</span>}
                </p>
                {c.work !== book.title && <p class="character-work">{c.work}</p>}
                <blockquote class="character-quote">「{c.quote}」</blockquote>
                <p class="character-translation">{c.translation}</p>
                {c.note && (
                  <p class="character-note">
                    <span class="detail-label">{copy.myTake}</span>
                    <span class="hand">{c.note[locale]}</span>
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {reading?.link && (
      <a class="weread-link" href={reading.link} target="_blank" rel="noopener noreferrer">
        {copy.openIn} ↗
      </a>
    )}
  </article>
</dialog>

<style>
  /* The dialog itself has no padding, so a click whose target is the dialog hit the backdrop */
  .book-dialog {
    width: min(40rem, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--fg);
    overflow: visible;
  }

  .book-dialog::backdrop {
    background: var(--scrim);
  }

  .book-sheet {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    padding: 1.4rem 1.5rem 1.5rem 1.75rem;
    background: var(--bg);
    border: 1.5px solid var(--fg);
    border-left: 10px solid var(--spine);
    border-radius: var(--radius-sm) var(--radius-md) var(--radius-md) var(--radius-sm);
    box-shadow: var(--shadow-hover);
  }

  .book-dialog[open] .book-sheet {
    animation: sheet-in 340ms var(--ease-out);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(16px) rotate(-1.5deg) scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-dialog[open] .book-sheet {
      animation: none;
    }
  }

  .sheet-close-form {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
  }

  .sheet-close {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--fg-muted);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition);
  }

  .sheet-close:hover,
  .sheet-close:focus-visible {
    border-color: var(--fg);
    color: var(--fg);
  }

  .sheet-close:active {
    transform: scale(0.94);
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-right: 2.5rem;
  }

  .detail-category,
  .detail-recent {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
  }

  .detail-category {
    background: var(--spine);
    color: var(--fg);
  }

  .detail-recent {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .detail-title {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.25;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    padding-right: 2rem;
  }

  .detail-title-en {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--fg-muted);
  }

  .detail-full-title {
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .detail-author {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .reading-facts {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.25rem;
    padding: 0.75rem 0.9rem;
    background: var(--surface);
    border-radius: var(--radius-sm);
  }

  .facts-hours {
    font-size: 1.6rem;
    line-height: 1.1;
  }

  .facts-meter {
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--border-dark);
    overflow: hidden;
  }

  .facts-meter span {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: inherit;
  }

  .facts-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .detail-about {
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .detail-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .detail-notes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--border-dark);
  }

  .detail-notes p {
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .detail-epigraph {
    margin: 0.5rem 0 0;
    padding: 0.75rem 0 0 1rem;
    border-left: 3px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .detail-epigraph blockquote {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .detail-epigraph figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.75rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .epigraph-translation {
    font-style: italic;
  }

  .detail-characters {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.75rem;
    margin-top: 0.5rem;
    border-top: 1px dashed var(--border-dark);
  }

  .character-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1.25rem 1.5rem;
  }

  .character {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .character-avatar {
    flex-shrink: 0;
    width: 80px;
    height: 100px;
    border-radius: var(--radius-sm);
  }

  .character-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .character-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.5rem;
  }

  .character-name-en,
  .character-work {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--fg-muted);
  }

  .character-quote {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .character-translation {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--fg-muted);
    line-height: 1.55;
  }

  .character-note {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-top: 0.2rem;
  }

  .character-note .hand {
    font-size: 1.15rem;
    line-height: 1.35;
  }

  .weread-link {
    align-self: flex-start;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
  }
</style>
